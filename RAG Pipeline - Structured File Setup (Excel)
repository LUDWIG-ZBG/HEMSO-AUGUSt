def _build_table_lookup(ws):
    """
    Returns:
      sheet_header_row_counts: unique headerRowCount values found in sheet tables
      table_lookup[(row, col)] = headerRowCount for cells inside a table
    """
    sheet_header_row_counts = []
    table_lookup = {}

    for _, tbl in ws.tables.items():
        min_col, min_row, max_col, max_row = range_boundaries(tbl.ref)
        header_row_count = _json_safe_value(getattr(tbl, "headerRowCount", None))

        if header_row_count is not None and header_row_count not in sheet_header_row_counts:
            sheet_header_row_counts.append(header_row_count)

        for r in range(min_row, max_row + 1):
            for c in range(min_col, max_col + 1):
                table_lookup[(r, c)] = header_row_count

    return sheet_header_row_counts, table_lookup


def sheet_to_json_text(ws) -> str:
    """
    Convert one openpyxl worksheet into minimal enriched JSON text.

    Structure:
      - sheet
      - rows
      - columns
      - cells
    """
    sheet_header_row_counts, table_lookup = _build_table_lookup(ws)

    rows = [_row_dimension_to_dict(row_idx) for row_idx in range(1, ws.max_row + 1)]
    columns = [_column_dimension_to_dict(col_idx) for col_idx in range(1, ws.max_column + 1)]

    cells = []
    for row in ws.iter_rows(min_row=1, max_row=ws.max_row, min_col=1, max_col=ws.max_column):
        for cell in row:
            cell_dict = {
                "row": cell.row,
                "column": cell.column,
                "value": _json_safe_value(cell.value),
                "data_type": _json_safe_value(_safe_attr(cell, "data_type")),
                "font": _font_to_dict(_safe_attr(cell, "font")),
                "fill": _fill_to_dict(_safe_attr(cell, "fill")),
                "border": _border_to_dict(_safe_attr(cell, "border")),
                "alignment": _alignment_to_dict(_safe_attr(cell, "alignment")),
                "style": _style_to_dict(cell),
                "headerRowCount": table_lookup.get((cell.row, cell.column)),
            }
            cells.append(cell_dict)

    payload = {
        "sheet": {
            "sheet_name": ws.title,
            "max_row": ws.max_row,
            "max_column": ws.max_column,
            "headerRowCount": sheet_header_row_counts if sheet_header_row_counts else None,
        },
        "rows": rows,
        "columns": columns,
        "cells": cells,
    }

    return json.dumps(payload, ensure_ascii=False, indent=2, default=str)


