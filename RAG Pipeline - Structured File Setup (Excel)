    return {
        "horizontal": _json_safe_value(alignment.horizontal),
        "vertical": _json_safe_value(alignment.vertical),
        "wrapText": _json_safe_value(_safe_attr(alignment, "wrapText")),
    }


def _style_to_dict(cell):
