def _json_safe_value(value):
    """
    Convert Excel/openpyxl values to JSON-safe values.
    """
    if value is None:
        return None
    if isinstance(value, (str, int, float, bool)):
        return value
    if isinstance(value, Decimal):
        return float(value)
    if isinstance(value, (datetime, date, time)):
        return value.isoformat()
    return str(value)


def _safe_attr(obj, attr, default=None):
    return getattr(obj, attr, default) if obj is not None else default


def _color_rgb(color):
    if color is None:
        return None
    return _json_safe_value(_safe_attr(color, "rgb"))


def _font_to_dict(font):
    if font is None:
        return None

    return {
        "name": _json_safe_value(font.name),
        "size": _json_safe_value(font.sz),
        "bold": _json_safe_value(font.b),
    }


def _fill_to_dict(fill):
    if fill is None:
        return None

    return {
        "type": _json_safe_value(_safe_attr(fill, "fill_type")),
        "rgb": _color_rgb(_safe_attr(fill, "fgColor")),
    }


def _side_style(side):
    if side is None:
        return None
    return _json_safe_value(_safe_attr(side, "style") or _safe_attr(side, "border_style"))


def _border_to_dict(border):
    if border is None:
        return None

    return {
        "left": _side_style(border.left),
        "right": _side_style(border.right),
        "top": _side_style(border.top),
        "bottom": _side_style(border.bottom),
    }


def _alignment_to_dict(alignment):
    if alignment is None:
