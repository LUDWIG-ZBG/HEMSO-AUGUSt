        f"Could not find sheet summaries file in OUT_PATH. Looked for: {candidate_paths}"
    )

# 2) Open txt file and extract sheet_id -> summary text
with open(summary_txt_path, "r", encoding="utf-8") as f:
    txt = f.read()

# Matches blocks like:
# sheet_nr: 1
# sheet_id: abc123
# sheet_name: My sheet
# summary:
# ...
# --------------------------------------------------------------------------------
pattern = re.compile(
    r"sheet_nr:\s*\d+\s*"
    r"sheet_id:\s*(?P<sheet_id>[^\n]+)\s*"
    r"(?:document:\s*(?P<document>[^\n]+)\s*)?"
    r"(?:doc_id:\s*(?P<doc_id>[^\n]+)\s*)?"
    r"sheet_name:\s*(?P<sheet_name>[^\n]*)\s*"
    r"summary:\s*\n(?P<summary>.*?)(?=\n-+\n|\Z)",
    re.DOTALL
)



for m in pattern.finditer(txt):
    sheet_id = m.group("sheet_id").strip()
    summary = (
        f"document: {(m.group('document') or m.group('doc_id') or '').strip()}\n"
        f"sheet_name: {(m.group('sheet_name') or '').strip()}\n"
        f"{m.group('summary').strip()}"
        ).strip()
    if sheet_id:
        sheet_summaries[sheet_id] = summary

