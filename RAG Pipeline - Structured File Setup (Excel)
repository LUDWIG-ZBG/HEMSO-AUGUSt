MONTH_SET = {m.lower() for m in MONTH_WORDS}


def _looks_like_year(x: Any) -> bool:
    return bool(re.fullmatch(r"(19|20)\d{2}", _safe_str(x).strip()))


def _looks_like_period(x: Any) -> bool:
    s = _normalize_text(x)
    return bool(
        re.fullmatch(r"(19|20)\d{2}\s*-\s*(0?[1-9]|1[0-2])", s)
        or s in MONTH_SET
        or bool(re.fullmatch(r"(q[1-4]|kv[1-4])", s))
    )


def _is_text_like(x: Any) -> bool:
    if _is_empty_value(x):
        return False
    return _parse_number(x) is None


def _group_contiguous(nums: List[int], gap: int = 1) -> List[List[int]]:
    nums = sorted(set(int(n) for n in nums))
    if not nums:
        return []

    groups = [[nums[0]]]
    for n in nums[1:]:
        if n - groups[-1][-1] <= gap:
            groups[-1].append(n)
        else:
            groups.append([n])
    return groups


def _compact_style_signals(cell: Dict[str, Any]) -> Dict[str, Any]:
    font = cell.get("font") or {}
    fill = cell.get("fill") or {}
    border = cell.get("border") or {}
    style = cell.get("style") or {}

    border_count = sum(
        1 for k in ("left", "right", "top", "bottom")
        if border.get(k) not in (None, "", "none")
    )

    return {
        "bold": bool(font.get("bold")),
        "filled": fill.get("type") not in (None, "", "none"),
        "border_count": border_count,
        "number_format": style.get("number_format"),
    }


def _compact_cell(cell: Dict[str, Any]) -> Dict[str, Any]:
    row = int(cell["row"])
    col = int(cell["column"])
    value = cell.get("value")

    return {
        "row": row,
        "column": col,
        "column_letter": get_column_letter(col),
        "value": value,
        "value_num": _parse_number(value),
        "data_type": cell.get("data_type"),
        "headerRowCount": cell.get("headerRowCount"),
        "style_signals": _compact_style_signals(cell),
    }


def _build_sparse_sheet(raw_payload: Dict[str, Any]) -> Dict[str, Any]:
    sheet_meta = raw_payload.get("sheet", {}) or {}
    cells_in = raw_payload.get("cells", []) or []

    non_empty_cells = []
    row_map = defaultdict(list)
    col_map = defaultdict(list)

    for cell in cells_in:
        if _is_empty_value(cell.get("value")):
            continue

        c = _compact_cell(cell)
        non_empty_cells.append(c)
        row_map[c["row"]].append(c)
        col_map[c["column"]].append(c)

    for r in row_map:
        row_map[r] = sorted(row_map[r], key=lambda x: x["column"])
    for c in col_map:
        col_map[c] = sorted(col_map[c], key=lambda x: x["row"])

    return {
        "sheet_meta": {
            "sheet_name": sheet_meta.get("sheet_name"),
            "max_row": int(sheet_meta.get("max_row") or 0),
            "max_column": int(sheet_meta.get("max_column") or 0),
            "headerRowCount": sheet_meta.get("headerRowCount"),
        },
        "cells": non_empty_cells,
        "row_map": row_map,
        "col_map": col_map,
    }


def _cells_within_bounds(cells: List[Dict[str, Any]], row_start: int, row_end: int, col_start: int, col_end: int) -> List[Dict[str, Any]]:
    return [
        c for c in cells
        if row_start <= c["row"] <= row_end and col_start <= c["column"] <= col_end
    ]


def _row_cells_in_bounds(row_cells: List[Dict[str, Any]], col_start: int, col_end: int) -> List[Dict[str, Any]]:
    return [c for c in row_cells if col_start <= c["column"] <= col_end]


def _col_cells_in_bounds(col_cells: List[Dict[str, Any]], row_start: int, row_end: int) -> List[Dict[str, Any]]:
    return [c for c in col_cells if row_start <= c["row"] <= row_end]


def _band_stats(cells: List[Dict[str, Any]]) -> Dict[str, Any]:
    rows = sorted({c["row"] for c in cells})
    cols = sorted({c["column"] for c in cells})

    row_counts = Counter(c["row"] for c in cells)
    col_counts = Counter(c["column"] for c in cells)

    numeric_count = sum(c["value_num"] is not None for c in cells)
    text_count = len(cells) - numeric_count

    row_density_values = list(row_counts.values())
    mean_row_density = sum(row_density_values) / max(len(row_density_values), 1)

    return {
        "row_count": len(rows),
        "col_count": len(cols),
        "rows": rows,
        "cols": cols,
        "numeric_count": numeric_count,
        "text_count": text_count,
        "numeric_ratio": numeric_count / max(len(cells), 1),
        "rows_with_2plus": sum(v >= 2 for v in row_counts.values()),
        "rows_with_3plus": sum(v >= 3 for v in row_counts.values()),
        "cols_with_2plus": sum(v >= 2 for v in col_counts.values()),
        "mean_row_density": mean_row_density,
    }


def _score_header_row(
    row_nr: int,
    rows_sorted: List[int],
    row_map: Dict[int, List[Dict[str, Any]]],
    col_start: int,
    col_end: int,
) -> float:
    row_cells = _row_cells_in_bounds(row_map.get(row_nr, []), col_start, col_end)
    if not row_cells:
        return 0.0

    non_empty = len(row_cells)
    year_cells = sum(_looks_like_year(c["value"]) for c in row_cells)
    period_cells = sum(_looks_like_period(c["value"]) for c in row_cells)
    numeric_cells = sum(c["value_num"] is not None for c in row_cells)
    text_cells = non_empty - numeric_cells

    bold_count = sum(bool((c.get("style_signals") or {}).get("bold")) for c in row_cells)
    filled_count = sum(bool((c.get("style_signals") or {}).get("filled")) for c in row_cells)
    border_count = sum(int((c.get("style_signals") or {}).get("border_count") or 0) > 0 for c in row_cells)

    header_hint = any(c.get("headerRowCount") not in (None, 0, "0") for c in row_cells)

    next_rows_numeric = 0
    row_pos = rows_sorted.index(row_nr)
    for next_row in rows_sorted[row_pos + 1: row_pos + 4]:
        next_cells = _row_cells_in_bounds(row_map.get(next_row, []), col_start, col_end)
        next_rows_numeric += sum(c["value_num"] is not None for c in next_cells)

    score = 0.0
    score += 0.5 if year_cells >= 2 else 0.0
    score += 0.5 if period_cells >= 2 else 0.0
    score += min(non_empty, 10) * 0.18
    score += min(text_cells, 10) * 0.12
    score -= min(numeric_cells, 10) * 0.08
    score += min(next_rows_numeric, 12) * 0.12
    score += bold_count * 1.5
    score += filled_count * 1.5
    score += border_count * 1.5

    if numeric_cells == 0:
        score += 0.35
    if text_cells >= 2 and next_rows_numeric >= 2:
        score += 1.10
    if row_cells and _parse_number(row_cells[0]["value"]) is None:
        score += 0.20
    if header_hint:
        score += 1.25

    return score


def _find_best_header_row(
    rows_sorted: List[int],
    row_map: Dict[int, List[Dict[str, Any]]],
    col_start: int,
    col_end: int,
    scan_limit: int = 8,
) -> Tuple[Optional[int], float]:
    candidate_rows = rows_sorted[:scan_limit]
    best_row = None
    best_score = 0.0

    for row_nr in candidate_rows:
        score = _score_header_row(
            row_nr=row_nr,
            rows_sorted=rows_sorted,
            row_map=row_map,
            col_start=col_start,
            col_end=col_end,
        )
        if score > best_score:
            best_row = row_nr
            best_score = score

    if best_score < 1.4:
        return None, best_score

    return best_row, best_score


def _score_header_col(
    col_nr: int,
    cols_sorted: List[int],
    col_map: Dict[int, List[Dict[str, Any]]],
    row_map: Dict[int, List[Dict[str, Any]]],
    row_start: int,
    row_end: int,
) -> float:
    col_cells = _col_cells_in_bounds(col_map.get(col_nr, []), row_start, row_end)
    if len(col_cells) < 2:
        return 0.0

    text_rows = sum(_is_text_like(c["value"]) for c in col_cells)
    numeric_rows = sum(c["value_num"] is not None for c in col_cells)
    bold_count = sum(bool((c.get("style_signals") or {}).get("bold")) for c in col_cells)

    right_side_numeric_rows = 0
    for c in col_cells:
        row_cells = row_map.get(c["row"], [])
        right_side = [x for x in row_cells if x["column"] != col_nr and x["column"] > col_nr]
        if any(x["value_num"] is not None for x in right_side):
            right_side_numeric_rows += 1

    unique_ratio = len({_normalize_text(c["value"]) for c in col_cells}) / max(len(col_cells), 1)
    text_ratio = text_rows / max(len(col_cells), 1)
    numeric_ratio = numeric_rows / max(len(col_cells), 1)

    score = 0.0
    score += len(col_cells) * 0.08
    score += unique_ratio * 1.40
    score += text_ratio * 1.20
    score -= numeric_ratio * 1.15
    score += right_side_numeric_rows * 0.12
    score += bold_count * 1.2

    if cols_sorted and col_nr == cols_sorted[0]:
        score += 0.40
    elif len(cols_sorted) > 1 and col_nr == cols_sorted[1]:
        score += 0.20

    return score


def _find_best_header_col(
    cols_sorted: List[int],
    col_map: Dict[int, List[Dict[str, Any]]],
    row_map: Dict[int, List[Dict[str, Any]]],
    row_start: int,
    row_end: int,
    scan_limit: int = 5,
) -> Tuple[Optional[int], float]:
    candidate_cols = cols_sorted[:scan_limit]
    best_col = None
    best_score = 0.0

    for col_nr in candidate_cols:
        score = _score_header_col(
            col_nr=col_nr,
            cols_sorted=cols_sorted,
            col_map=col_map,
            row_map=row_map,
            row_start=row_start,
            row_end=row_end,
        )
        if score > best_score:
            best_col = col_nr
            best_score = score

    if best_score < 0.9:
        return None, best_score

    return best_col, best_score


def _table_candidate_score(
    cells: List[Dict[str, Any]],
    header_row_score: float,
    header_col_score: float,
) -> float:
    stats = _band_stats(cells)

    score = 0.0
    if stats["row_count"] >= 3:
        score += 1.50
    if stats["col_count"] >= 2:
        score += 0.80
    if stats["col_count"] >= 3:
        score += 0.60

    score += 0.80 if stats["rows_with_2plus"] >= 2 else 0.0
    score += 0.60 if stats["rows_with_3plus"] >= 2 else 0.0
    score += 0.50 if stats["cols_with_2plus"] >= 2 else 0.0

    if 0.05 <= stats["numeric_ratio"] <= 0.95:
        score += 0.80
    if 0.15 <= stats["numeric_ratio"] <= 0.85:
        score += 0.40

    if stats["mean_row_density"] >= 2.0:
        score += 0.50

    score += min(header_row_score, 4.0) * 0.35
    score += min(header_col_score, 3.0) * 0.25

    return score


def _extract_context_block(cells: List[Dict[str, Any]], block_id: str) -> Dict[str, Any]:
    row_map = defaultdict(list)
    for c in cells:
        row_map[c["row"]].append(c)

    lines = []
    for row_nr in sorted(row_map.keys()):
        parts = [_safe_str(c["value"]).strip() for c in sorted(row_map[row_nr], key=lambda x: x["column"])]
        parts = [p for p in parts if p]
        if parts:
            lines.append({
                "row_nr": row_nr,
                "text": " | ".join(parts),
            })

    all_text = " ".join(line["text"] for line in lines).strip()
    normalized_terms = sorted({
        _normalize_text(tok)
        for tok in re.split(r"\s+", all_text)
        if _normalize_text(tok)
    })

    return {
        "block_id": block_id,
        "region_type": "context_block",
        "bounds": {
            "row_start": min(c["row"] for c in cells),
            "row_end": max(c["row"] for c in cells),
            "col_start": min(c["column"] for c in cells),
            "col_end": max(c["column"] for c in cells),
        },
        "text_lines": lines,
        "normalized_terms": normalized_terms[:200],
    }


def _row_label_candidates(row_cells: List[Dict[str, Any]], header_col: Optional[int]) -> List[str]:
    row_cells = sorted(row_cells, key=lambda x: x["column"])

    candidates = []

    if header_col is not None:
        for c in row_cells:
            if c["column"] == header_col and not _is_empty_value(c["value"]):
                candidates.append(_safe_str(c["value"]).strip())
                break

    text_values = [
        _safe_str(c["value"]).strip()
        for c in row_cells
        if _is_text_like(c["value"])
    ]

    if text_values:
        candidates.append(text_values[0])
        if len(text_values) >= 2:
            candidates.append(" | ".join(text_values[:2]))
        if len(text_values) >= 3:
            candidates.append(" | ".join(text_values[:3]))

    # även blandade rader som t.ex. "2019 | Energi | kWh"
    mixed_values = [_safe_str(c["value"]).strip() for c in row_cells[:4] if not _is_empty_value(c["value"])]
    if mixed_values:
        candidates.append(" | ".join(mixed_values))

    out = []
    seen = set()
    for cand in candidates:
        norm = _normalize_text(cand)
        if norm and norm not in seen:
            seen.add(norm)
            out.append(cand)

    return out


def _build_region(
    region_id: str,
    cells: List[Dict[str, Any]],
    row_map: Dict[int, List[Dict[str, Any]]],
    col_map: Dict[int, List[Dict[str, Any]]],
) -> Dict[str, Any]:
    rows_sorted = sorted({c["row"] for c in cells})
    cols_sorted = sorted({c["column"] for c in cells})

    row_start, row_end = rows_sorted[0], rows_sorted[-1]
    col_start, col_end = cols_sorted[0], cols_sorted[-1]

    header_row, header_row_score = _find_best_header_row(
        rows_sorted=rows_sorted,
        row_map=row_map,
        col_start=col_start,
        col_end=col_end,
    )
    header_col, header_col_score = _find_best_header_col(
        cols_sorted=cols_sorted,
        col_map=col_map,
        row_map=row_map,
        row_start=row_start,
        row_end=row_end,
    )

    table_score = _table_candidate_score(
        cells=cells,
        header_row_score=header_row_score,
        header_col_score=header_col_score,
    )

    stats = _band_stats(cells)

    # kolumnmetadata
    header_row_cells = {
        c["column"]: c
        for c in _row_cells_in_bounds(row_map.get(header_row, []), col_start, col_end)
    } if header_row is not None else {}

    columns_meta = []
    for col_nr in cols_sorted:
        header_label = None
        normalized_header_label = None

        if col_nr in header_row_cells:
            header_label = _safe_str(header_row_cells[col_nr]["value"]).strip() or None
            normalized_header_label = _normalize_text(header_label) if header_label else None

        columns_meta.append({
            "column_nr": col_nr,
            "column_letter": get_column_letter(col_nr),
            "kind": "header_column" if header_col == col_nr else "data_column",
            "label": header_label,
            "normalized_label": normalized_header_label,
        })

    # radmetadata
    rows_meta = []
    row_label_map = defaultdict(list)
    column_label_map = defaultdict(list)

    for col_meta in columns_meta:
        if col_meta["normalized_label"]:
            column_label_map[col_meta["normalized_label"]].append({
                "region_id": region_id,
                "column_nr": col_meta["column_nr"],
                "column_letter": col_meta["column_letter"],
                "label": col_meta["label"],
            })

    data_rows = [r for r in rows_sorted if header_row is None or r > header_row]

    for row_nr in rows_sorted:
        row_cells = _row_cells_in_bounds(row_map.get(row_nr, []), col_start, col_end)
        label_candidates = _row_label_candidates(row_cells, header_col=header_col)

        normalized_candidates = []
        for cand in label_candidates:
            norm = _normalize_text(cand)
            if norm:
                normalized_candidates.append(norm)
                row_label_map[norm].append({
                    "region_id": region_id,
                    "row_nr": row_nr,
                    "label": cand,
                })

        rows_meta.append({
            "row_nr": row_nr,
            "kind": (
                "header_row" if header_row == row_nr
                else "data_row" if row_nr in data_rows
                else "row"
            ),
            "label_candidates": label_candidates,
            "normalized_label_candidates": sorted(set(normalized_candidates)),
        })

    region_cells = []
    for c in sorted(cells, key=lambda x: (x["row"], x["column"])):
        region_cells.append({
            "row": c["row"],
            "column": c["column"],
            "column_letter": c["column_letter"],
            "value": c["value"],
            "value_num": c["value_num"],
            "data_type": c["data_type"],
        })

    return {
        "region_id": region_id,
        "region_type": "table_region",
        "bounds": {
            "row_start": row_start,
            "row_end": row_end,
            "col_start": col_start,
            "col_end": col_end,
        },
        "shape": {
            "row_count": stats["row_count"],
            "col_count": stats["col_count"],
            "non_empty_cell_count": len(cells),
        },
        "scores": {
            "table_candidate_score": round(table_score, 4),
            "header_row_score": round(header_row_score, 4),
            "header_col_score": round(header_col_score, 4),
        },
        "confidence": round(min(table_score / 5.0, 0.99), 4),
        "header_row_indices": [header_row] if header_row is not None else [],
        "header_column_indices": [header_col] if header_col is not None else [],
        "data_row_start": (header_row + 1) if header_row is not None else row_start,
        "rows": rows_meta,
        "columns": columns_meta,
        "cells": region_cells,
        "lookup_index": {
            "row_label_map": dict(sorted(row_label_map.items())),
            "column_label_map": dict(sorted(column_label_map.items())),
        },
    }


def _split_prefix_context_if_needed(
    cells: List[Dict[str, Any]],
    row_map: Dict[int, List[Dict[str, Any]]],
    header_row: Optional[int],
    col_start: int,
    col_end: int,
) -> Tuple[List[Dict[str, Any]], List[Dict[str, Any]]]:
    if header_row is None:
        return [], cells

    rows_sorted = sorted({c["row"] for c in cells})
    prefix_rows = [r for r in rows_sorted if r < header_row]
    if not prefix_rows:
        return [], cells

    prefix_cells = [c for c in cells if c["row"] in prefix_rows]
    body_cells = [c for c in cells if c["row"] >= header_row]

    if not prefix_cells or not body_cells:
        return [], cells

    prefix_numeric_ratio = sum(c["value_num"] is not None for c in prefix_cells) / max(len(prefix_cells), 1)
    prefix_row_density = len(prefix_cells) / max(len(prefix_rows), 1)

    # konservativ split: bara om prefix tydligt ser ut som kontext
    if prefix_numeric_ratio < 0.15 and prefix_row_density <= 2.2:
        return prefix_cells, body_cells

    return [], cells


def _detect_regions_and_context(sparse_sheet: Dict[str, Any]) -> Tuple[List[Dict[str, Any]], List[Dict[str, Any]]]:
    cells = sparse_sheet["cells"]
    row_map = sparse_sheet["row_map"]
    col_map = sparse_sheet["col_map"]

    if not cells:
        return [], []

    occupied_rows = sorted(row_map.keys())
    row_groups = _group_contiguous(occupied_rows, gap= MAX_EMPTY_ROW_GAP+1)

    regions = []
    context_blocks = []
    covered_coords = set()
    region_counter = 0
    context_counter = 0

    for row_group in row_groups:
        band_cells = [c for c in cells if c["row"] in row_group]
        band_cols = sorted({c["column"] for c in band_cells})

        if not band_cols:
            continue

        col_groups = _group_contiguous(band_cols, gap=MAX_EMPTY_COL_GAP + 1)

        for col_group in col_groups:
            row_start, row_end = min(row_group), max(row_group)
            col_start, col_end = min(col_group), max(col_group)

            sub_cells = _cells_within_bounds(
                cells=band_cells,
                row_start=row_start,
                row_end=row_end,
                col_start=col_start,
                col_end=col_end,
            )
            if not sub_cells:
                continue

            rows_sorted = sorted({c["row"] for c in sub_cells})
            cols_sorted = sorted({c["column"] for c in sub_cells})

            header_row, header_row_score = _find_best_header_row(
                rows_sorted=rows_sorted,
                row_map=row_map,
                col_start=col_start,
                col_end=col_end,
            )
            header_col, header_col_score = _find_best_header_col(
                cols_sorted=cols_sorted,
                col_map=col_map,
                row_map=row_map,
                row_start=row_start,
                row_end=row_end,
            )

            table_score = _table_candidate_score(
                cells=sub_cells,
                header_row_score=header_row_score,
                header_col_score=header_col_score,
            )

            prefix_cells, maybe_table_cells = _split_prefix_context_if_needed(
                cells=sub_cells,
                row_map=row_map,
                header_row=header_row,
                col_start=col_start,
                col_end=col_end,
            )

            # uppdatera score efter split om vi skapade prefix-kontext
            if maybe_table_cells != sub_cells:
                sub_cells = maybe_table_cells
                rows_sorted = sorted({c["row"] for c in sub_cells})
                cols_sorted = sorted({c["column"] for c in sub_cells})

                header_row, header_row_score = _find_best_header_row(
                    rows_sorted=rows_sorted,
                    row_map=row_map,
                    col_start=min(cols_sorted),
                    col_end=max(cols_sorted),
                )
                header_col, header_col_score = _find_best_header_col(
                    cols_sorted=cols_sorted,
                    col_map=col_map,
                    row_map=row_map,
                    row_start=min(rows_sorted),
                    row_end=max(rows_sorted),
                )
                table_score = _table_candidate_score(
                    cells=sub_cells,
                    header_row_score=header_row_score,
                    header_col_score=header_col_score,
                )

            if prefix_cells:
                context_counter += 1
                context_blocks.append(
                    _extract_context_block(prefix_cells, block_id=f"ctx_{context_counter}")
                )
                for c in prefix_cells:
                    covered_coords.add((c["row"], c["column"]))

            if table_score >= 2.8 and len(rows_sorted) >= 2 and len(cols_sorted) >= 2:
                region_counter += 1
                region = _build_region(
                    region_id=f"r{region_counter}",
                    cells=sub_cells,
                    row_map=row_map,
                    col_map=col_map,
                )
                regions.append(region)
                for c in sub_cells:
                    covered_coords.add((c["row"], c["column"]))
            else:
                # ej tillräckligt tabell-lik -> kontext
                leftovers = [c for c in sub_cells if (c["row"], c["column"]) not in covered_coords]
                if leftovers:
                    context_counter += 1
                    context_blocks.append(
                        _extract_context_block(leftovers, block_id=f"ctx_{context_counter}")
                    )
                    for c in leftovers:
                        covered_coords.add((c["row"], c["column"]))

    # eventuella kvarvarande celler som varken blev region eller prefix-kontext
    remaining = [c for c in cells if (c["row"], c["column"]) not in covered_coords]
    if remaining:
        remaining_rows = sorted({c["row"] for c in remaining})
        for rg in _group_contiguous(remaining_rows, gap= MAX_EMPTY_ROW_GAP + 1):
            block_cells = [c for c in remaining if c["row"] in rg]
            if block_cells:
                context_counter += 1
                context_blocks.append(
                    _extract_context_block(block_cells, block_id=f"ctx_{context_counter}")
                )

    return regions, context_blocks


def _aggregate_lookup_index(
    table_regions: List[Dict[str, Any]],
    context_blocks: List[Dict[str, Any]],
) -> Dict[str, Any]:
    row_label_map = defaultdict(list)
    column_label_map = defaultdict(list)
    context_term_map = defaultdict(list)

    for region in table_regions:
        r_index = region.get("lookup_index", {}) or {}

        for key, hits in (r_index.get("row_label_map") or {}).items():
            row_label_map[key].extend(hits)

        for key, hits in (r_index.get("column_label_map") or {}).items():
            column_label_map[key].extend(hits)

    for block in context_blocks:
        for term in block.get("normalized_terms", []) or []:
            if term:
                context_term_map[term].append({
                    "block_id": block["block_id"],
                    "region_type": block["region_type"],
                })

    return {
        "row_label_map": dict(sorted(row_label_map.items())),
        "column_label_map": dict(sorted(column_label_map.items())),
        "context_term_map": dict(sorted(context_term_map.items())),
    }


def enrich_sheet_json(sheet_dict: Dict[str, Any]) -> Dict[str, Any]:
    raw_json = sheet_dict.get("JSON")
    if not raw_json:
        return sheet_dict

    raw_payload = json.loads(raw_json)
    sparse_sheet = _build_sparse_sheet(raw_payload)

    table_regions, context_blocks = _detect_regions_and_context(sparse_sheet)
    lookup_index = _aggregate_lookup_index(table_regions, context_blocks)

    enriched_payload = {
        "schema_version": ANATOMY_SCHEMA_VERSION,
        "sheet": {
            "sheet_name": sparse_sheet["sheet_meta"].get("sheet_name"),
            "sheet_nr": int(sheet_dict.get("sheet_nr") or 0),
            "max_row": sparse_sheet["sheet_meta"].get("max_row"),
            "max_column": sparse_sheet["sheet_meta"].get("max_column"),
            "headerRowCount": sparse_sheet["sheet_meta"].get("headerRowCount"),
        },
        "stats": {
            "raw_non_empty_cell_count": len(sparse_sheet["cells"]),
            "table_region_count": len(table_regions),
            "context_block_count": len(context_blocks),
        },
        "table_regions": table_regions,
        "context_blocks": context_blocks,
        "lookup_index": lookup_index,
    }

    out = dict(sheet_dict)
    out["JSON_raw"] = raw_json
    out["JSON"] = json.dumps(enriched_payload, ensure_ascii=False, indent=2)
    out["anatomy_schema_version"] = ANATOMY_SCHEMA_VERSION
    out["table_region_count"] = len(table_regions)
    out["context_block_count"] = len(context_blocks)

    return out


