def _compact_bounds(bounds: Dict[str, Any]) -> Dict[str, Any]:
    if not isinstance(bounds, dict):
        return {}
    return {
        "row_start": bounds.get("row_start"),
        "row_end": bounds.get("row_end"),
        "col_start": bounds.get("col_start"),
        "col_end": bounds.get("col_end"),
    }


def _compact_text_lines(lines: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    out = []
    for line in lines or []:
        row_nr = line.get("row_nr")
        text = _safe_str(line.get("text")).strip()
        if row_nr is None or not text:
            continue
        out.append({
            "row_nr": int(row_nr),
            "text": text,
        })
    return out


def _compact_region_rows(rows: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    out = []
    for row in rows or []:
        row_nr = row.get("row_nr")
        if row_nr is None:
            continue

        item = {
            "row_nr": int(row_nr),
            "kind": row.get("kind"),
            "normalized_label_candidates": sorted(
                {
                    _normalize_text(x)
                    for x in (row.get("normalized_label_candidates") or [])
                    if _normalize_text(x)
                }
            ),
        }

        raw_candidates = [
            _safe_str(x).strip()
            for x in (row.get("label_candidates") or [])
            if _safe_str(x).strip()
        ]
        if raw_candidates:
            item["label_candidates"] = raw_candidates

        out.append(item)

    return out


def _compact_region_columns(columns: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    out = []
    for col in columns or []:
        col_nr = col.get("column_nr")
        if col_nr is None:
            continue

        item = {
            "column_nr": int(col_nr),
            "column_letter": col.get("column_letter") or get_column_letter(int(col_nr)),
            "kind": col.get("kind"),
        }

        label = _safe_str(col.get("label")).strip()
        normalized_label = _normalize_text(col.get("normalized_label"))

        if label:
            item["label"] = label
        if normalized_label:
            item["normalized_label"] = normalized_label

        out.append(item)

    return out


def _compact_region_cells(cells: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    out = []

    for cell in cells or []:
        value = cell.get("value")
        if _is_empty_value(value):
            continue

        row_nr = cell.get("row")
        col_nr = cell.get("column")
        if row_nr is None or col_nr is None:
            continue

        item = {
            "row": int(row_nr),
            "column": int(col_nr),
            "column_letter": cell.get("column_letter") or get_column_letter(int(col_nr)),
            "value": value,
        }

        value_num = cell.get("value_num")
        if value_num is not None:
            item["value_num"] = value_num

        data_type = cell.get("data_type")
        if data_type not in (None, ""):
            item["data_type"] = data_type

        out.append(item)

    out.sort(key=lambda x: (x["row"], x["column"]))
    return out


def _dedupe_hit_list(hit_list: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    out = []
    seen = set()

    for hit in hit_list or []:
        if not isinstance(hit, dict):
            continue

        key = (
            hit.get("region_id"),
            hit.get("row_nr"),
            hit.get("column_nr"),
            hit.get("column_letter"),
            hit.get("label"),
            hit.get("block_id"),
            hit.get("region_type"),
        )
        if key in seen:
            continue
        seen.add(key)

        compact_hit = {}
        for k in ("region_id", "row_nr", "column_nr", "column_letter", "label", "block_id", "region_type"):
            if hit.get(k) not in (None, "", [], {}):
                compact_hit[k] = hit.get(k)

        out.append(compact_hit)

    return out


def _compact_lookup_map(m: Dict[str, Any]) -> Dict[str, Any]:
    out = {}
    for key, hits in (m or {}).items():
        norm_key = _normalize_text(key)
        if not norm_key:
            continue

        deduped_hits = _dedupe_hit_list(hits)
        if deduped_hits:
            out[norm_key] = deduped_hits

    return dict(sorted(out.items()))


def _compact_region_lookup_index(region_lookup: Dict[str, Any]) -> Dict[str, Any]:
    return {
        "row_label_map": _compact_lookup_map(region_lookup.get("row_label_map") or {}),
        "column_label_map": _compact_lookup_map(region_lookup.get("column_label_map") or {}),
    }


def _compact_table_region(region: Dict[str, Any]) -> Dict[str, Any]:
    compact_region = {
        "region_id": region.get("region_id"),
        "region_type": "table_region",
        "bounds": _compact_bounds(region.get("bounds") or {}),
        "header_row_indices": [int(x) for x in (region.get("header_row_indices") or []) if x is not None],
        "header_column_indices": [int(x) for x in (region.get("header_column_indices") or []) if x is not None],
        "data_row_start": region.get("data_row_start"),
        "rows": _compact_region_rows(region.get("rows") or []),
        "columns": _compact_region_columns(region.get("columns") or []),
        "cells": _compact_region_cells(region.get("cells") or []),
        "lookup_index": _compact_region_lookup_index(region.get("lookup_index") or {}),
    }

    return compact_region


def _compact_context_block(block: Dict[str, Any]) -> Dict[str, Any]:
    terms = sorted(
        {
            _normalize_text(x)
            for x in (block.get("normalized_terms") or [])
            if _normalize_text(x)
        }
    )

    return {
        "block_id": block.get("block_id"),
        "region_type": "context_block",
        "bounds": _compact_bounds(block.get("bounds") or {}),
        "text_lines": _compact_text_lines(block.get("text_lines") or []),
        "normalized_terms": terms,
    }


def compact_enriched_sheet_json(sheet_dict: Dict[str, Any]) -> Dict[str, Any]:
    raw_json = sheet_dict.get("JSON")
    if not raw_json:
        return sheet_dict

    payload = json.loads(raw_json)

    # Om JSON inte kommer från anatomy enrichment, låt den vara
    if payload.get("schema_version") not in {
        ANATOMY_SCHEMA_VERSION,
        COMPACTION_SCHEMA_VERSION,
    }:
        return sheet_dict

    table_regions = [
        _compact_table_region(region)
        for region in (payload.get("table_regions") or [])
    ]

    context_blocks = [
        _compact_context_block(block)
        for block in (payload.get("context_blocks") or [])
    ]

    compact_payload = {
        "schema_version": COMPACTION_SCHEMA_VERSION,
        "sheet": {
            "sheet_name": (payload.get("sheet") or {}).get("sheet_name"),
            "sheet_nr": (payload.get("sheet") or {}).get("sheet_nr"),
            "max_row": (payload.get("sheet") or {}).get("max_row"),
            "max_column": (payload.get("sheet") or {}).get("max_column"),
        },
        "stats": {
            "table_region_count": len(table_regions),
            "context_block_count": len(context_blocks),
            "sparse_cell_count": sum(len(r.get("cells") or []) for r in table_regions),
        },
        "table_regions": table_regions,
        "context_blocks": context_blocks,
        "lookup_index": {
            "row_label_map": _compact_lookup_map((payload.get("lookup_index") or {}).get("row_label_map") or {}),
            "column_label_map": _compact_lookup_map((payload.get("lookup_index") or {}).get("column_label_map") or {}),
            "context_term_map": _compact_lookup_map((payload.get("lookup_index") or {}).get("context_term_map") or {}),
        },
    }

    out = dict(sheet_dict)
    out["JSON"] = json.dumps(compact_payload, ensure_ascii=False, indent=2)
    out["anatomy_schema_version"] = COMPACTION_SCHEMA_VERSION
    out["table_region_count"] = len(table_regions)
    out["context_block_count"] = len(context_blocks)

    if REMOVE_DEBUG_FIELDS_FROM_SHEET_DICT:
        out.pop("JSON_raw", None)

    return out


