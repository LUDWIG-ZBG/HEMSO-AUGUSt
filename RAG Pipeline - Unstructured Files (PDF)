def normalize_element_type(cat: Optional[str]) -> str:
    """
    Remap raw categories into normalized categories.
    """

    if not cat:
        return "Other"

    c = str(cat).strip()
    c_lower = c.lower()

    #if c_lower in {"other", "unknown"}:
    #    return "Other

    if c_lower in {"narrativetext", "image","uncategorizedtext", "listitem"}:
        return "Text"

    if c_lower in {"table"}:
        return "Table"

    if c_lower in {"figurecaption", "figure_caption"}:
        return "Title"

    if c_lower == "header":
        return "Title"

    if c_lower in {"figure", "picture"}:
        return "Figure"

    return c


def _normalize_element_types(dets: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    """
    Normalize element types in-place using raw_category when available.
    """
    for d in dets:
        raw_cat = d.get("raw_category", d.get("element_type"))
        d["element_type"] = normalize_element_type(raw_cat)
    return dets

def _map_nearest_preceding_title(
    dets: List[Dict[str, Any]],
) -> List[Dict[str, Any]]:
    """
    Assign each element an `element_title` equal to the nearest preceding Title
    on the same page, based on ascending y1/x1 order.

    Logic
    -----
    For each page:
      - sort elements by ascending y1, then x1
      - identify all Title elements
      - split the page into title-led segments:
          [Title_i, ..., just before Title_(i+1))
      - assign element_title = raw_text of Title_i for every element in that segment

    Notes
    -----
    - Elements before the first Title on a page get element_title = None
    - Title elements themselves also get element_title set to their own raw_text
    - The function mutates `dets` in place and also returns it
    """

    def _etype(d: Dict[str, Any]) -> str:
        return str(d.get("element_type") or "").strip().lower()

    pages, no_bbox_items = _group_dets_by_page(dets)
    new_dets: List[Dict[str, Any]] = []

    for page in sorted(pages.keys()):
        y1_sort = _sort_page_dets_reading_order(pages[page])

        current_title = None

        for d in y1_sort:
            if _etype(d) == "title":
                current_title = (d.get("raw_text") or "").strip() or None

            d["element_title"] = current_title

        new_dets.extend(y1_sort)

    # Preserve bbox-less items and ensure key exists there too
    for d in no_bbox_items:
        if "element_title" not in d:
            d["element_title"] = None
        new_dets.append(d)

    dets[:] = _sort_global_dets(new_dets)
    return dets

