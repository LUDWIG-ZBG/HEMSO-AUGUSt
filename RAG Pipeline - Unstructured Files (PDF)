def parse_tables_summary_txt(text: str) -> dict:
    """
    Parse a file formatted like:
      table 1
      <summary...>
      table 2
      <summary...>
    Returns {1: "<summary...>", 2: "<summary...>", ...}
    """
    lines = text.splitlines()
    out = {}
    cur_idx = None
    buf = []

    header_re = re.compile(r"^\s*table\s+(\d+)\s*$", re.IGNORECASE)

    def flush():
        nonlocal cur_idx, buf
        if cur_idx is not None:
            out[cur_idx] = "\n".join(buf).strip() or None
        buf = []

    for ln in lines:
        m = header_re.match(ln)
        if m:
            flush()
            cur_idx = int(m.group(1))
            continue

        if cur_idx is not None and re.match(r"^\s*-{3,}\s*$", ln):
            continue

        if cur_idx is not None:
            buf.append(ln)

    flush()
    return out

