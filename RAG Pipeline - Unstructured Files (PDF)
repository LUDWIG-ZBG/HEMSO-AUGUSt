def rotate_second_rendered_image_90_right(image_paths: List[str]) -> List[str]:
    """
    Rotate the 2nd image in image_paths 90 degrees clockwise (to the right).
    Overwrites the existing image file and returns image_paths unchanged.
    """
    if not image_paths or len(image_paths) < 2:
        raise ValueError("image_paths must contain at least 2 images.")

    img_path = image_paths[1]  # second page, 0-based index

    with Image.open(img_path) as img:
        rotated = img.rotate(-90, expand=True)  # clockwise
        rotated.save(img_path)

    return image_paths

