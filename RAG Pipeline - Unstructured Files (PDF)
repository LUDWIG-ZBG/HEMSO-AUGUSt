page_image_cache: Dict[int, Image.Image] = {}

cropped_count = 0
skipped_count = 0

for d in dets:
    # Reset image field by default
    d["image"] = None

    element_type = str(d.get("element_type") or "").strip().lower()
    if element_type not in {"text", "table"}:
        continue

    page_idx = d.get("page")
    bbox = d.get("bbox_xyxy")

    if page_idx is None or bbox is None:
        skipped_count += 1
        continue

    page_idx = int(page_idx)

    if page_idx < 1 or page_idx > len(image_paths):
        skipped_count += 1
        continue

    # Load page image once
    if page_idx not in page_image_cache:
        page_img = Image.open(image_paths[page_idx - 1]).convert("RGB")
        page_image_cache[page_idx] = page_img

    page_img = page_image_cache[page_idx]
    W, H = page_img.size

    x1, y1, x2, y2 = bbox
    cx1, cy1, cx2, cy2 = _clip_box(x1, y1, x2, y2, W, H, pad=PAD)

    if cx2 <= cx1 or cy2 <= cy1:
        skipped_count += 1
        continue

    cropped = page_img.crop((cx1, cy1, cx2, cy2)).copy()

    # Store cropped image directly in the dets element dictionary
    d["image"] = cropped

    cropped_count += 1

