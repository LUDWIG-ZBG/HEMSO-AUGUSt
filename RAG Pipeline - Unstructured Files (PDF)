def coords_to_xyxy(coords) -> Optional[Tuple[float, float, float, float]]:
    """Convert Unstructured metadata.coordinates polygon -> bbox (x1, y1, x2, y2)."""
    if coords is None:
        return None

    pts = None
    if hasattr(coords, "points"):
        pts = getattr(coords, "points", None)
    elif isinstance(coords, dict):
        pts = coords.get("points")

    if not pts:
        return None

    try:
        xs = [float(p[0]) for p in pts]
        ys = [float(p[1]) for p in pts]
        return (min(xs), min(ys), max(xs), max(ys))
    except Exception:
        return None


def _sort_page_dets_reading_order(page_dets: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    """Sort detections in page reading order: top-to-bottom, then left-to-right."""
    return sorted(page_dets, key=lambda d: (d["bbox_xyxy"][1], d["bbox_xyxy"][0]))


def _sort_global_dets(dets: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    """Sort detections globally by page, then page reading order."""
    return sorted(
        dets,
        key=lambda d: (
            d.get("page", 0),
            d["bbox_xyxy"][1] if d.get("bbox_xyxy") is not None else float("inf"),
            d["bbox_xyxy"][0] if d.get("bbox_xyxy") is not None else float("inf"),
        ),
    )


def _group_dets_by_page(
    dets: List[Dict[str, Any]]
) -> Tuple[Dict[int, List[Dict[str, Any]]], List[Dict[str, Any]]]:
    """
    Group detections by page.
    Returns:
      - pages: {page_number: [detections_with_bbox]}
      - no_bbox_items: detections without bbox (preserved unchanged)
    """
    pages: Dict[int, List[Dict[str, Any]]] = {}
    no_bbox_items: List[Dict[str, Any]] = []

    for d in dets:
        if d.get("bbox_xyxy") is None:
            no_bbox_items.append(d)
            continue
        pages.setdefault(d["page"], []).append(d)

    return pages, no_bbox_items

