def _cluster_other_detections_one_page(
    page_dets: List[Dict[str, Any]],
    breaker_types: set = {"Text", "Table"},
) -> List[Dict[str, Any]]:
    """
    Merge neighboring 'Other' detections in page reading order unless interrupted by
    a Text or Table element.

    The merged cluster is returned as ONE single Table element.

    NOTE:
    This is a one-page helper. Use _cluster_other_detections(...) on the full dets list.
    """
    dets_sorted = _sort_page_dets_reading_order(page_dets)

    out: List[Dict[str, Any]] = []
    cluster_items: List[Dict[str, Any]] = []

    def flush_cluster():
        nonlocal cluster_items
        if not cluster_items:
            return

        boxes = [d["bbox_xyxy"] for d in cluster_items if d.get("bbox_xyxy") is not None]
        if not boxes:
            cluster_items = []
            return

        x1 = min(b[0] for b in boxes)
        y1 = min(b[1] for b in boxes)
        x2 = max(b[2] for b in boxes)
        y2 = max(b[3] for b in boxes)

        merged_text = "\n".join(
            [d["raw_text"] for d in cluster_items if d.get("raw_text")]
        ).strip() or None

        first = cluster_items[0]

        out.append({
            "element_id": first["element_id"],
            "element_type": "Table",
            "raw_category": first.get("raw_category"),
            "raw_text": merged_text,
            "page": first["page"],
            "bbox_xyxy": (x1, y1, x2, y2),
        })

        cluster_items = []

    for d in dets_sorted:
        element_type = d["element_type"]

        if element_type in breaker_types:
            flush_cluster()
            out.append(d)
            continue

        if element_type == "Other":
            cluster_items.append(d)
            continue

        out.append(d)

    flush_cluster()
    return _sort_page_dets_reading_order(out)


def _cluster_other_detections(
    dets: List[Dict[str, Any]],
    breaker_types: set = {"Text", "Table"},
) -> List[Dict[str, Any]]:
    """
    Page-safe wrapper for clustering 'Other' detections on the full dets list.
    Mutates dets in place and also returns it.
    """
    pages, no_bbox_items = _group_dets_by_page(dets)

    new_dets: List[Dict[str, Any]] = []

    for page in sorted(pages.keys()):
        page_out = _cluster_other_detections_one_page(
            pages[page],
            breaker_types=breaker_types,
        )
        new_dets.extend(page_out)

    new_dets.extend(no_bbox_items)
    dets[:] = _sort_global_dets(new_dets)
    return dets


def _cluster_parallel_text_neighbors(
    dets: List[Dict[str, Any]],
    y_tolerance: float = 0.0,
) -> List[Dict[str, Any]]:
    """
    Cluster Text elements that are on the same page and have overlapping
    y-coordinates (vertical span overlap).

    Rules:
      - Only elements with element_type == "Text" are clustered.
      - Clustering is done per page.
      - If A overlaps B in y, and B overlaps C in y, they are merged into
        the same cluster (transitive grouping).
      - Each cluster becomes ONE single Text element.
      - Non-Text elements are preserved unchanged.

    The function MUTATES `dets` in place and also returns it.
    """

    def _etype(d: Dict[str, Any]) -> str:
        return str(d.get("element_type") or "").strip().lower()

    def y_overlaps(
        b1: Tuple[float, float, float, float],
        b2: Tuple[float, float, float, float],
        tol: float = 0.0,
    ) -> bool:
        _, y1a, _, y2a = b1
        _, y1b, _, y2b = b2
        return max(y1a, y1b) <= min(y2a, y2b) + tol

    def merge_cluster(cluster: List[Dict[str, Any]]) -> Dict[str, Any]:
        boxes = [d["bbox_xyxy"] for d in cluster if d.get("bbox_xyxy") is not None]
        if not boxes:
            return cluster[0]

        x1 = min(b[0] for b in boxes)
        y1 = min(b[1] for b in boxes)
        x2 = max(b[2] for b in boxes)
        y2 = max(b[3] for b in boxes)

        # Keep reading order inside the merged text line
        cluster_sorted = sorted(
            cluster,
            key=lambda d: (d["bbox_xyxy"][1], d["bbox_xyxy"][0]),
        )

        merged_text = " ".join(
            (d.get("raw_text") or "").strip()
            for d in cluster_sorted
            if (d.get("raw_text") or "").strip()
        ).strip() or None

        first = cluster_sorted[0]

        return {
            "element_id": first["element_id"],
            "element_type": "Text",
            "raw_category": first.get("raw_category"),
            "raw_text": merged_text,
            "page": first["page"],
            "bbox_xyxy": (x1, y1, x2, y2),
        }

    pages, no_bbox_items = _group_dets_by_page(dets)
    new_dets: List[Dict[str, Any]] = []

    for page in sorted(pages.keys()):
        page_items = pages[page]

        text_items = [
            d for d in page_items
            if _etype(d) == "text" and d.get("bbox_xyxy") is not None
        ]
        other_items = [
            d for d in page_items
            if not (_etype(d) == "text" and d.get("bbox_xyxy") is not None)
        ]

        text_items = _sort_page_dets_reading_order(text_items)

        visited = set()
        merged_text_items: List[Dict[str, Any]] = []

        for i in range(len(text_items)):
            if i in visited:
                continue

            stack = [i]
            component = []
            visited.add(i)

            while stack:
                cur_idx = stack.pop()
                cur = text_items[cur_idx]
                component.append(cur)

                for j, cand in enumerate(text_items):
                    if j in visited:
                        continue
                    if y_overlaps(cur["bbox_xyxy"], cand["bbox_xyxy"], tol=y_tolerance):
                        visited.add(j)
                        stack.append(j)

            if len(component) == 1:
                merged_text_items.append(component[0])
            else:
                merged_text_items.append(merge_cluster(component))

        page_out = other_items + merged_text_items
        page_out = _sort_page_dets_reading_order(page_out)
        new_dets.extend(page_out)

    new_dets.extend(no_bbox_items)
    dets[:] = _sort_global_dets(new_dets)
    return dets

def _merge_titles_into_overlapping_text(
    dets: List[Dict[str, Any]],
    y_tolerance: float = 0.0,
) -> List[Dict[str, Any]]:
    """
    For each page:
      - find Text elements
      - find Title elements
      - if a Title vertically overlaps a Text element (y-span overlap),
        merge the Title into that Text element
      - the merged result remains a single Text element

    Notes
    -----
    - Matching is page-local only
    - A text item can absorb multiple overlapping titles
    - Title items that get merged are removed as standalone items
    - Non-overlapping titles remain unchanged
    - Mutates dets in place and also returns it
    """

    def _etype(d: Dict[str, Any]) -> str:
        return str(d.get("element_type") or "").strip().lower()

    def y_overlaps(
        b1: Tuple[float, float, float, float],
        b2: Tuple[float, float, float, float],
        tol: float = 0.0,
    ) -> bool:
        _, y1a, _, y2a = b1
        _, y1b, _, y2b = b2
        return max(y1a, y1b) <= min(y2a, y2b) + tol

    def merge_text_with_titles(
        text_d: Dict[str, Any],
        title_list: List[Dict[str, Any]],
    ) -> Dict[str, Any]:
        cluster = title_list + [text_d]
        cluster_sorted = sorted(
            cluster,
            key=lambda d: (d["bbox_xyxy"][1], d["bbox_xyxy"][0]),
        )

        boxes = [d["bbox_xyxy"] for d in cluster_sorted if d.get("bbox_xyxy") is not None]
        if not boxes:
            return text_d

        x1 = min(b[0] for b in boxes)
        y1 = min(b[1] for b in boxes)
        x2 = max(b[2] for b in boxes)
        y2 = max(b[3] for b in boxes)

        merged_text = "\n\n".join(
            txt
            for txt in (
                (d.get("raw_text") or "").strip()
                for d in cluster_sorted
            )
            if txt
        ).strip() or None

        merged = dict(text_d)
        merged.update({
            "element_id": text_d["element_id"],
            "element_type": "Text",
            "raw_category": text_d.get("raw_category"),
            "raw_text": merged_text,
            "page": text_d["page"],
            "bbox_xyxy": (x1, y1, x2, y2),
        })
        return merged

    pages, no_bbox_items = _group_dets_by_page(dets)
    new_dets: List[Dict[str, Any]] = []

    for page in sorted(pages.keys()):
        page_items = _sort_page_dets_reading_order(pages[page])

        text_items = [
            d for d in page_items
            if _etype(d) == "text" and d.get("bbox_xyxy") is not None
        ]
        title_items = [
            d for d in page_items
            if _etype(d) == "title" and d.get("bbox_xyxy") is not None
        ]
        other_items = [
            d for d in page_items
            if _etype(d) not in {"text", "title"} or d.get("bbox_xyxy") is None
        ]

        used_title_ids = set()
        merged_text_items: List[Dict[str, Any]] = []

        for text_d in text_items:
            text_box = text_d["bbox_xyxy"]

            overlapping_titles = []
            for title_d in title_items:
                if title_d["element_id"] in used_title_ids:
                    continue
                if y_overlaps(text_box, title_d["bbox_xyxy"], tol=y_tolerance):
                    overlapping_titles.append(title_d)

            if overlapping_titles:
                merged_text_items.append(merge_text_with_titles(text_d, overlapping_titles))
                for t in overlapping_titles:
                    used_title_ids.add(t["element_id"])
            else:
                merged_text_items.append(text_d)

        remaining_titles = [
            d for d in title_items
            if d["element_id"] not in used_title_ids
        ]

        page_out = other_items + remaining_titles + merged_text_items
        page_out = _sort_page_dets_reading_order(page_out)
        new_dets.extend(page_out)

    new_dets.extend(no_bbox_items)
    dets[:] = _sort_global_dets(new_dets)
    return dets


def _merge_titles_into_overlapping_tables(
    dets: List[Dict[str, Any]],
    y_tolerance: float = 0.0,
) -> List[Dict[str, Any]]:
    """
    For each page:
      - find Table elements
      - find Title elements
      - if a Title vertically overlaps a Table element (y-span overlap),
        merge the Title into that Table element
      - the merged result remains a single Table element

    Notes
    -----
    - Matching is page-local only
    - A table item can absorb multiple overlapping titles
    - Title items that get merged are removed as standalone items
    - Non-overlapping titles remain unchanged
    - Mutates dets in place and also returns it
    """

    def _etype(d: Dict[str, Any]) -> str:
        return str(d.get("element_type") or "").strip().lower()

    def y_overlaps(
        b1: Tuple[float, float, float, float],
        b2: Tuple[float, float, float, float],
        tol: float = 0.0,
    ) -> bool:
        _, y1a, _, y2a = b1
        _, y1b, _, y2b = b2
        return max(y1a, y1b) <= min(y2a, y2b) + tol

    def merge_table_with_titles(
        table_d: Dict[str, Any],
        title_list: List[Dict[str, Any]],
    ) -> Dict[str, Any]:
        cluster = title_list + [table_d]
        cluster_sorted = sorted(
            cluster,
            key=lambda d: (d["bbox_xyxy"][1], d["bbox_xyxy"][0]),
        )

        boxes = [d["bbox_xyxy"] for d in cluster_sorted if d.get("bbox_xyxy") is not None]
        if not boxes:
            return table_d

        x1 = min(b[0] for b in boxes)
        y1 = min(b[1] for b in boxes)
        x2 = max(b[2] for b in boxes)
        y2 = max(b[3] for b in boxes)

        merged_text = "\n\n".join(
            txt
            for txt in (
                (d.get("raw_text") or "").strip()
                for d in cluster_sorted
            )
            if txt
        ).strip() or None

        merged = dict(table_d)
        merged.update({
            "element_id": table_d["element_id"],
            "element_type": "Table",
            "raw_category": table_d.get("raw_category"),
            "raw_text": merged_text,
            "page": table_d["page"],
            "bbox_xyxy": (x1, y1, x2, y2),
        })
        return merged

    pages, no_bbox_items = _group_dets_by_page(dets)
    new_dets: List[Dict[str, Any]] = []

    for page in sorted(pages.keys()):
        page_items = _sort_page_dets_reading_order(pages[page])

        table_items = [
            d for d in page_items
            if _etype(d) == "table" and d.get("bbox_xyxy") is not None
        ]
        title_items = [
            d for d in page_items
            if _etype(d) == "title" and d.get("bbox_xyxy") is not None
        ]
        other_items = [
            d for d in page_items
            if _etype(d) not in {"table", "title"} or d.get("bbox_xyxy") is None
        ]

        used_title_ids = set()
        merged_table_items: List[Dict[str, Any]] = []

        for table_d in table_items:
            table_box = table_d["bbox_xyxy"]

            overlapping_titles = []
            for title_d in title_items:
                if title_d["element_id"] in used_title_ids:
                    continue
                if y_overlaps(table_box, title_d["bbox_xyxy"], tol=y_tolerance):
                    overlapping_titles.append(title_d)

            if overlapping_titles:
                merged_table_items.append(
                    merge_table_with_titles(table_d, overlapping_titles)
                )
                for t in overlapping_titles:
                    used_title_ids.add(t["element_id"])
            else:
                merged_table_items.append(table_d)

        remaining_titles = [
            d for d in title_items
            if d["element_id"] not in used_title_ids
        ]

        page_out = other_items + remaining_titles + merged_table_items
        page_out = _sort_page_dets_reading_order(page_out)
        new_dets.extend(page_out)

    new_dets.extend(no_bbox_items)
    dets[:] = _sort_global_dets(new_dets)
    return dets

def _cluster_parallel_title_neighbors(
    dets: List[Dict[str, Any]],
    y_tolerance: float = 0.0,
) -> List[Dict[str, Any]]:
    """
    Cluster Title elements that are on the same page and have overlapping
    y-coordinates (vertical span overlap).

    Rules:
      - Only elements with element_type == "Title" are clustered
      - Clustering is done per page
      - If A overlaps B in y, and B overlaps C in y, they are merged into
        the same cluster (transitive grouping)
      - Each cluster becomes ONE single Title element
      - Non-Title elements are preserved unchanged

    Mutates `dets` in place and also returns it.
    """

    def _etype(d: Dict[str, Any]) -> str:
        return str(d.get("element_type") or "").strip().lower()

    def y_overlaps(
        b1: Tuple[float, float, float, float],
        b2: Tuple[float, float, float, float],
        tol: float = 0.0,
    ) -> bool:
        _, y1a, _, y2a = b1
        _, y1b, _, y2b = b2
        return max(y1a, y1b) <= min(y2a, y2b) + tol

    def merge_cluster(cluster: List[Dict[str, Any]]) -> Dict[str, Any]:
        boxes = [d["bbox_xyxy"] for d in cluster if d.get("bbox_xyxy") is not None]
        if not boxes:
            return cluster[0]

        x1 = min(b[0] for b in boxes)
        y1 = min(b[1] for b in boxes)
        x2 = max(b[2] for b in boxes)
        y2 = max(b[3] for b in boxes)

        cluster_sorted = sorted(
            cluster,
            key=lambda d: (d["bbox_xyxy"][1], d["bbox_xyxy"][0]),
        )

        merged_text = " ".join(
            (d.get("raw_text") or "").strip()
            for d in cluster_sorted
            if (d.get("raw_text") or "").strip()
        ).strip() or None

        first = cluster_sorted[0]

        merged = dict(first)
        merged.update({
            "element_id": first["element_id"],
            "element_type": "Title",
            "raw_category": first.get("raw_category"),
            "raw_text": merged_text,
            "page": first["page"],
            "bbox_xyxy": (x1, y1, x2, y2),
        })
        return merged

    pages, no_bbox_items = _group_dets_by_page(dets)
    new_dets: List[Dict[str, Any]] = []

    for page in sorted(pages.keys()):
        page_items = pages[page]

        title_items = [
            d for d in page_items
            if _etype(d) == "title" and d.get("bbox_xyxy") is not None
        ]
        other_items = [
            d for d in page_items
            if not (_etype(d) == "title" and d.get("bbox_xyxy") is not None)
        ]

        title_items = _sort_page_dets_reading_order(title_items)

        visited = set()
        merged_title_items: List[Dict[str, Any]] = []

        for i in range(len(title_items)):
            if i in visited:
                continue

            stack = [i]
            component = []
            visited.add(i)

            while stack:
                cur_idx = stack.pop()
                cur = title_items[cur_idx]
                component.append(cur)

                for j, cand in enumerate(title_items):
                    if j in visited:
                        continue
                    if y_overlaps(cur["bbox_xyxy"], cand["bbox_xyxy"], tol=y_tolerance):
                        visited.add(j)
                        stack.append(j)

            if len(component) == 1:
                merged_title_items.append(component[0])
            else:
                merged_title_items.append(merge_cluster(component))

        page_out = other_items + merged_title_items
        page_out = _sort_page_dets_reading_order(page_out)
        new_dets.extend(page_out)

    new_dets.extend(no_bbox_items)
    dets[:] = _sort_global_dets(new_dets)
    return dets

def _cluster_consecutive_text_blocks(
    dets: List[Dict[str, Any]],
) -> List[Dict[str, Any]]:
    """
    Merge consecutive Text elements on the same page in reading order.

    A text run is clustered into one Text object if the items are adjacent
    in page reading order, BUT clustering is blocked if the would-be merged
    text bbox overlaps any Title or Table element on the same page.

    Practical effect:
      - Title / Table always break clustering
      - Figure / Other / etc do not break clustering
      - page boundaries always block clustering
      - a text cluster is prevented from expanding across regions occupied by
        Title or Table elements

    Mutates `dets` in place and also returns it.
    """

    def _etype(d: Dict[str, Any]) -> str:
        return str(d.get("element_type") or "").strip().lower()

    def boxes_overlap(
        b1: Tuple[float, float, float, float],
        b2: Tuple[float, float, float, float],
    ) -> bool:
        x1a, y1a, x2a, y2a = b1
        x1b, y1b, x2b, y2b = b2
        return not (x2a < x1b or x2b < x1a or y2a < y1b or y2b < y1a)

    def merged_bbox(cluster: List[Dict[str, Any]]) -> Optional[Tuple[float, float, float, float]]:
        boxes = [d["bbox_xyxy"] for d in cluster if d.get("bbox_xyxy") is not None]
        if not boxes:
            return None

        x1 = min(b[0] for b in boxes)
        y1 = min(b[1] for b in boxes)
        x2 = max(b[2] for b in boxes)
        y2 = max(b[3] for b in boxes)
        return (x1, y1, x2, y2)

    def merge_cluster(cluster: List[Dict[str, Any]]) -> Dict[str, Any]:
        if len(cluster) == 1:
            return cluster[0]

        cluster_sorted = _sort_page_dets_reading_order(cluster)
        bbox = merged_bbox(cluster_sorted)

        if bbox is None:
            return cluster_sorted[0]

        merged_text = "\n\n".join(
            txt
            for txt in (
                (d.get("raw_text") or "").strip()
                for d in cluster_sorted
            )
            if txt
        ).strip() or None

        first = cluster_sorted[0]

        merged = dict(first)
        merged.update({
            "element_id": first["element_id"],
            "element_type": "Text",
            "raw_category": first.get("raw_category"),
            "raw_text": merged_text,
            "page": first["page"],
            "bbox_xyxy": bbox,
        })
        return merged

    pages, no_bbox_items = _group_dets_by_page(dets)
    new_dets: List[Dict[str, Any]] = []

    for page in sorted(pages.keys()):
        page_items = _sort_page_dets_reading_order(pages[page])

        blocker_boxes = [
            d["bbox_xyxy"]
            for d in page_items
            if _etype(d) in {"title", "table"} and d.get("bbox_xyxy") is not None
        ]

        page_out: List[Dict[str, Any]] = []
        text_cluster: List[Dict[str, Any]] = []

        def flush_cluster():
            nonlocal text_cluster
            if not text_cluster:
                return
            page_out.append(merge_cluster(text_cluster))
            text_cluster = []

        for d in page_items:
            et = _etype(d)

            if et == "text":
                if not text_cluster:
                    text_cluster.append(d)
                else:
                    candidate_cluster = text_cluster + [d]
                    candidate_bbox = merged_bbox(candidate_cluster)

                    overlaps_blocker = (
                        candidate_bbox is not None
                        and any(boxes_overlap(candidate_bbox, bb) for bb in blocker_boxes)
                    )

                    if overlaps_blocker:
                        flush_cluster()
                        text_cluster.append(d)
                    else:
                        text_cluster.append(d)

            elif et in {"title", "table"}:
                flush_cluster()
                page_out.append(d)

            else:
                # Figure / Other / etc do not break the text run
                continue

        flush_cluster()
        new_dets.extend(_sort_page_dets_reading_order(page_out))

    new_dets.extend(no_bbox_items)
    dets[:] = _sort_global_dets(new_dets)
    return dets

