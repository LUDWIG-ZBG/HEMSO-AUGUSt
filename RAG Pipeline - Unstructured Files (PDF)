def _clip_box(x1, y1, x2, y2, W, H, pad=0):
    x1 = max(0, int(x1) - pad)
    y1 = max(0, int(y1) - pad)
    x2 = min(W, int(x2) + pad)
    y2 = min(H, int(y2) + pad)
    return x1, y1, x2, y2

