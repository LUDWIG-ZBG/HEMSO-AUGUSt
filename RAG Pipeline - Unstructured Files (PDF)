def run_det_postprocessing(dets: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    pipeline = [
        _normalize_element_types,
        lambda xs: _cluster_parallel_title_neighbors(xs, y_tolerance=0.0),
        lambda xs: _cluster_parallel_text_neighbors(xs, y_tolerance=0.2),
        lambda xs: _merge_titles_into_overlapping_text(xs, y_tolerance=0.0),
        lambda xs: _merge_titles_into_overlapping_tables(xs, y_tolerance=0.0),
        _cluster_consecutive_text_blocks,
        _cluster_consecutive_table_blocks,
        lambda xs: _cluster_other_detections(xs, breaker_types={"Text", "Table"}),
        _map_nearest_preceding_title,
    ]

    for fn in pipeline:
        dets = fn(dets)

    dets[:] = _sort_global_dets(dets)
    return dets
    
