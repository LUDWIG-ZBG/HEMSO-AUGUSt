def write_json_for_element(element_cat: str):
    element_cat = str(element_cat or "").strip().lower()
    if not element_cat:
        raise ValueError("element_cat must be a non-empty string.")

    prompt = _prompt_for_element(element_cat)

    # Match dets[] on element_type and require image
    matched_dets = sorted(
        [
            d for d in dets
            if str(d.get("element_type") or "").strip().lower() == element_cat
            and d.get("image") is not None
        ],
        key=_element_sort_key,
    )

    if not matched_dets:
        print(f'❌ No elements found for element_type="{element_cat}" with non-empty image.')
        return []

    json_list = []
    output_rows = []

    total = len(matched_dets)

    for i, det in enumerate(matched_dets, start=1):
        try:
            cropped = det["image"]

            # Encode cropped PNG -> base64 data URL
            buf = io.BytesIO()
            cropped.save(buf, format="PNG")
            img_b64 = base64.b64encode(buf.getvalue()).decode("utf-8")
            data_url = f"data:image/png;base64,{img_b64}"

            payload = {
                "messages": [
                    {
                        "role": "user",
                        "content": [
                            {"type": "text", "text": prompt},
                            {"type": "image_url", "image_url": {"url": data_url}},
                        ],
                    }
                ],
                "temperature": 0.0,
                "max_tokens": 4000,
            }

            resp = requests.post(invoke_url_JSON, headers=headers, json=payload, timeout=300)

            element_id = det.get("element_id")
            element_title = det.get("element_title")
            page = det.get("page")

            if resp.status_code != 200:
                print(f'❌ {element_cat} {i}/{total} failed')
                print("Status:", resp.status_code)
                print("Response:", resp.text[:2000])

                error_obj = {
                    "_error_status": resp.status_code,
                    "_error_response": resp.text[:5000],
                }
                json_list.append(error_obj)

                output_rows.append({
                    element_cat: i,
                    "element_id": element_id,
                    "element_title": element_title,
                    "page": page,
                    "json_text": error_obj,
                })
                continue

            result = resp.json()
            model_text = _extract_message_text(result)

            # Try parse returned JSON text
            try:
                parsed = _try_parse_json(model_text)
            except Exception:
                parsed = {
                    "_raw_model_output": model_text,
                    "_full_response": result,
                }

            json_list.append(parsed)

            output_rows.append({
                element_cat: i,
                "element_id": element_id,
                "element_title": element_title,
                "page": page,
                "json_text": parsed,
            })

            print(f'✅ Extracted {element_cat} {i}/{total}')

        except Exception as e:
            print(f'❌ {element_cat} {i}/{total} crashed: {e}')

            element_id = det.get("element_id")
            element_title = det.get("element_title")
            page = det.get("page")

            error_obj = {"_exception": str(e)}
            json_list.append(error_obj)

            output_rows.append({
                element_cat: i,
                "element_id": element_id,
                "element_title": element_title,
                "page": page,
                "json_text": error_obj,
            })

    # Save file
    os.makedirs(OUT_PATH, exist_ok=True)
    out_file = Path(OUT_PATH) / f"{element_cat}_json.json"
    out_file.write_text(
        json.dumps(output_rows, ensure_ascii=False, indent=2),
        encoding="utf-8"
    )

    print(f"\nSaved -> {out_file}")
    print(f"✅ Wrote {len(output_rows)} item(s) for element_type='{element_cat}'")

    # Preview first 2
    if output_rows:
        print(json.dumps(output_rows[:2], ensure_ascii=False, indent=2))

    return json_list

