def parse_text_summaries_txt(text: str) -> dict:
    """
    Supports blocks like:

      Text 1
      Element id: aac5c077c6c8_p0001_e000008
      <summary...>

      Text 2
      Element id: aac5c077c6c8_p0001_e000009
      <summary...>

    Also supports older format:

      aac5c077c6c8_p0001_e000008
      <summary...>

    Returns:
      {element_id: summary_text, ...}
    """
    lines = text.splitlines()
    out = {}
    cur_id = None
    buf = []

    text_header_re = re.compile(r"^\s*text\s+\d+\s*$", re.IGNORECASE)
    element_id_re  = re.compile(r"^\s*element\s+id\s*:\s*(\S+)\s*$", re.IGNORECASE)
    plain_id_re    = re.compile(r"^\s*([A-Za-z0-9]+_p\d{4}_e\d{6})\s*$", re.IGNORECASE)

    def flush():
        nonlocal cur_id, buf
        if cur_id is not None:
            summary = "\n".join(buf).strip()
            if summary:
                out[cur_id] = summary
        cur_id = None
        buf = []

    for ln in lines:
        # New "Text i" block
        if text_header_re.match(ln):
            if cur_id is not None:
                flush()
            continue

        # Explicit "Element id: ..."
        m = element_id_re.match(ln)
        if m:
            if cur_id is not None:
                flush()
            cur_id = m.group(1).strip()
            continue

        # Older format: first line is just the element_id
        m = plain_id_re.match(ln)
        if m and cur_id is None:
            cur_id = m.group(1).strip()
            continue

        if cur_id is not None:
            buf.append(ln)

    flush()
    return out

