# DBSQL retrival helpers
def _validate_uc_table_name(table_name: str) -> str:
    """
    Minimal safety check because table names cannot be parameterized.
    Allows catalog.schema.table.
    """
    table_name = str(table_name or "").strip()
    if not re.fullmatch(r"[A-Za-z0-9_]+\.[A-Za-z0-9_]+\.[A-Za-z0-9_]+", table_name):
        raise ValueError(f"Invalid Unity Catalog table name: {table_name}")
    return table_name

