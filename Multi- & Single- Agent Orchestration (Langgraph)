def build_evidence_from_observation(
    observation: Dict[str, Any],
    existing_items: List[EvidenceItem],
) -> List[EvidenceItem]:
    tool_name = observation.get("tool", "")
    tool_args = observation.get("tool_args", {}) or {}

    tool_result = normalize_raw_tool_result(
        raw_observation=observation,
        tool_name=tool_name,
        tool_args=tool_args,
    )

    return build_evidence_from_tool_result(
        tool_result=tool_result,
        existing_items=existing_items,
    )


# Final answer text only from the model.
