@tool
def clause_lookup(element_id: Union[str, List[str]]):
    """Hämta innehåll från en .pdf fil för ett eller flera element_id när elementtypen är text eller table."""
    if isinstance(element_id, str):
        element_id = [element_id]

    element_id = [str(x).strip() for x in (element_id or []) if str(x).strip()]

    if not element_id:
        return ToolResponse(
            tool="clause_lookup",
            status="No",
            message="No element_id was detected",
            data=[],
            sources=[],
        ).model_dump()

    query = f"""
        SELECT
            doc_id,
            element_id,
            page,
            element_type,
            raw_text,
            raw_table
        FROM {DBSQL_TABLE}
        WHERE element_id IN ({_placeholders(element_id)})
    """

    rows = dbsql_fetch_all(query, element_id)

    order_map = {eid: i for i, eid in enumerate(element_id)}
    rows = sorted(rows, key=lambda r: order_map.get(r["element_id"], 10**9))

    data = []
    sources = []

    for row in rows:
        file_type = infer_file_type(row["doc_id"])
        if file_type != "pdf":
            continue

        content = row.get("raw_text") or row.get("raw_table") or ""

        if row.get("element_type") == "Text":
            content = row.get("raw_text") or ""
        elif row.get("element_type") == "Table":
            content = row.get("raw_table") or ""

        data.append({
            "doc_id": row["doc_id"],
            "element_id": row["element_id"],
            "page": row["page"],
            "element_type": row["element_type"],
            "content": content,
        })

        sources.append(
            SourceRef(
                doc_id=row["doc_id"],
                element_id=row["element_id"],
                page=row["page"],
                element_type=row["element_type"],
            )
        )

    return ToolResponse(
        tool="clause_lookup",
        status="Ok" if data else "Inga resultat hittades",
        message=f"{len(data)} pdf-chunks hittade",
        data=data,
        sources=sources,
    ).model_dump()

@tool
def sheet_labels(element_id: str):
    """Hämta enkla rad- och kolumnlabels från ett sheet element baserat på header_row_indices och header_column_indices."""

    def _dedupe_preserve_order(values: List[Any]) -> List[str]:
        out = []
        seen = set()
        for v in values or []:
            s = str(v).strip()
            if not s:
                continue
            if s in seen:
                continue
            seen.add(s)
            out.append(s)
        return out

    if not element_id or not str(element_id).strip():
        return ToolResponse(
            tool="sheet_labels",
            status="ERROR",
            message="sheet_labels requires element_id",
            data=[],
            sources=[],
        ).model_dump()

    element_id = str(element_id).strip()

    rows = dbsql_fetch_all(
        f"""
        SELECT
            doc_id,
            page,
            element_type,
            element_title,
            raw_table
        FROM {DBSQL_TABLE}
        WHERE element_id = ?
        """,
        [element_id],
    )

    if not rows:
        return ToolResponse(
            tool="sheet_labels",
            status="No",
            message="No matching sheet found",
            data=[],
            sources=[],
        ).model_dump()

    row = rows[0]
    doc_id = row["doc_id"]
    page = row["page"]
    element_type = str(row["element_type"] or "").strip()
    file_type = infer_file_type(doc_id)

    source_ref = SourceRef(
        doc_id=doc_id,
        element_id=element_id,
        page=page,
        element_type=element_type,
    )

    if file_type not in {"xlsx", "xls"}:
        return ToolResponse(
            tool="sheet_labels",
            status="ERROR",
            message=f"sheet_labels requires .xlsx/.xls but got {file_type}",
            data=[],
            sources=[source_ref],
        ).model_dump()

    if element_type.lower() != "sheet":
        return ToolResponse(
            tool="sheet_labels",
            status="ERROR",
            message=f"sheet_labels requires element_type='Sheet' but got '{element_type}'",
            data=[],
            sources=[source_ref],
        ).model_dump()

    try:
        payload = _sheet_load_payload(row["raw_table"])
    except Exception as e:
        return ToolResponse(
            tool="sheet_labels",
            status="ERROR",
            message=f"Invalid anatomy JSON in raw_table: {repr(e)}",
            data=[],
            sources=[source_ref],
        ).model_dump()

    region_by_id = _sheet_region_by_id(payload)

    if not region_by_id:
        return ToolResponse(
            tool="sheet_labels",
            status="No",
            message="No table_regions found in sheet anatomy JSON",
            data=[],
            sources=[source_ref],
        ).model_dump()

    row_labels = []
    column_labels = []

    for region_id, region in sorted(region_by_id.items(), key=lambda x: str(x[0])):
        header_rows = {int(x) for x in (region.get("header_row_indices") or []) if x is not None}
        header_cols = {int(x) for x in (region.get("header_column_indices") or []) if x is not None}
        cells = region.get("cells", []) or []

        header_row_cells = sorted(
            [
                c for c in cells
                if c.get("row") is not None
                and int(c.get("row")) in header_rows
                and c.get("value") is not None
                and str(c.get("value")).strip() != ""
            ],
            key=lambda c: (int(c.get("row")), int(c.get("column") or 10**9))
        )

        header_col_cells = sorted(
            [
                c for c in cells
                if c.get("column") is not None
                and int(c.get("column")) in header_cols
                and c.get("value") is not None
                and str(c.get("value")).strip() != ""
            ],
            key=lambda c: (int(c.get("column")), int(c.get("row") or 10**9))
        )

        column_labels.extend(str(c.get("value")).strip() for c in header_row_cells)
        row_labels.extend(str(c.get("value")).strip() for c in header_col_cells)

    row_labels = _dedupe_preserve_order(row_labels)
    column_labels = _dedupe_preserve_order(column_labels)

    target_labels_text = (
        f"Rad Labels: {row_labels}\n"
        f"Kolumn Labels: {column_labels}"
    )

    data_item = {
        "sheet_name": (payload.get("sheet") or {}).get("sheet_name") or row.get("element_title"),
        "sheet_nr": (payload.get("sheet") or {}).get("sheet_nr", page),
        "row_labels": row_labels,
        "column_labels": column_labels,
        "target_labels": target_labels_text,
    }

    return ToolResponse(
        tool="sheet_labels",
        status="Ok",
        message=(
            f"rad-labels: {len(row_labels)}"
            f"kolumn-labels: {len(column_labels)}"
        ),
        data=[data_item],
        sources=[source_ref],
    ).model_dump()

@tool
def sheet_lookup(element_id: str, target_labels: List[str]):
    """Hämta specifika värden ur en .xlsx fil för chunks med element_type=Sheet genom att matcha target_labels mot rader och kolumner."""

    if isinstance(target_labels, str):
        target_labels = [target_labels]

    target_labels = [
        str(x).strip()
        for x in (target_labels or [])
        if str(x).strip()
    ]

    if not element_id:
        return ToolResponse(
            tool="sheet_lookup",
            status="ERROR",
            message="sheet_lookup requires element_id",
            data=[],
            sources=[],
        ).model_dump()

    element_id = str(element_id).strip()

    if not target_labels:
        return ToolResponse(
            tool="sheet_lookup",
            status="ERROR",
            message="sheet_lookup requires target_labels",
            data=[],
            sources=[],
        ).model_dump()

    rows = dbsql_fetch_all(
        f"""
        SELECT
            doc_id,
            page,
            element_type,
            raw_table
        FROM {DBSQL_TABLE}
        WHERE element_id = ?
        """,
        [element_id],
    )

    if not rows:
        return ToolResponse(
            tool="sheet_lookup",
            status="No",
            message="No matching sheet found",
            data=[],
            sources=[],
        ).model_dump()

    row = rows[0]
    file_type = infer_file_type(row["doc_id"])
    element_type = str(row["element_type"] or "").strip().lower()

    if file_type not in {"xlsx", "xls"}:
        return ToolResponse(
            tool="sheet_lookup",
            status="ERROR",
            message=f"sheet_lookup requires .xlsx/.xls but got {file_type}",
            data=[],
            sources=[],
        ).model_dump()

    if element_type != "sheet":
        return ToolResponse(
            tool="sheet_lookup",
            status="ERROR",
            message=f"sheet_lookup requires element_type='Sheet' but got '{row['element_type']}'",
            data=[],
            sources=[],
        ).model_dump()

    try:
        payload = _sheet_load_payload(row["raw_table"])
    except Exception as e:
        return ToolResponse(
            tool="sheet_lookup",
            status="ERROR",
            message=f"Invalid anatomy JSON in raw_table: {repr(e)}",
            data=[],
            sources=[],
        ).model_dump()

    region_by_id = _sheet_region_by_id(payload)

    if not region_by_id:
        return ToolResponse(
            tool="sheet_lookup",
            status="No",
            message="No table_regions found in sheet anatomy JSON",
            data=[],
            sources=[
                SourceRef(
                    doc_id=row["doc_id"],
                    element_id=element_id,
                    page=row["page"],
                    element_type=row["element_type"],
                )
            ],
        ).model_dump()

    resolved_rows, resolved_cols, unmatched = _sheet_resolve_hits(
        target_labels=target_labels,
        payload=payload,
    )

    rows_by_region = defaultdict(list)
    cols_by_region = defaultdict(list)

    for hit in resolved_rows:
        rows_by_region[hit["region_id"]].append(hit)

    for hit in resolved_cols:
        cols_by_region[hit["region_id"]].append(hit)

    all_region_ids = sorted(set(rows_by_region.keys()) | set(cols_by_region.keys()))

    data = []
    for region_id in all_region_ids:
        region = region_by_id.get(region_id)
        if not region:
            continue

        row_hits = sorted(rows_by_region.get(region_id, []), key=lambda x: x["row_nr"])
        col_hits = sorted(cols_by_region.get(region_id, []), key=lambda x: x["column_nr"])

        if row_hits and col_hits:
            data.extend(_sheet_collect_intersections(region, row_hits, col_hits))
        elif row_hits:
            data.extend(_sheet_collect_row_scan(region, row_hits))
        elif col_hits:
            data.extend(_sheet_collect_column_scan(region, col_hits))

    data = _sheet_dedupe_items(data)

    matched_labels = []
    seen_label = set()
    for hit in resolved_rows + resolved_cols:
        label = str(hit.get("target_label") or "").strip()
        if label and label not in seen_label:
            seen_label.add(label)
            matched_labels.append(label)

    status = "Ok" if data else "No"

    if data:
        message = (
            f"{len(data)} values extracted from sheet. "
            f"Matched labels: {matched_labels or []}. "
            f"Unmatched labels: {unmatched or []}."
        )
    else:
        message = (
            f"No values extracted. "
            f"Matched labels: {matched_labels or []}. "
            f"Unmatched labels: {unmatched or []}."
        )

    return ToolResponse(
        tool="sheet_lookup",
        status=status,
        message=message,
        data=data,
        sources=[
            SourceRef(
                doc_id=row["doc_id"],
                element_id=element_id,
                page=row["page"],
                element_type=row["element_type"],
            )
        ],
    ).model_dump()

@tool
def calculate(expression: str) -> Dict[str, Any]:
    """Genomför säkra aritmetiska beräkningar med siffror från bevisen."""

    allowed = {
        ast.Add: op.add,
        ast.Sub: op.sub,
        ast.Mult: op.mul,
        ast.Div: op.truediv,
        ast.Pow: op.pow,
        ast.USub: op.neg,
    }

    def eval_node(node):
        if isinstance(node, ast.Constant) and isinstance(node.value, (int, float)):
            return node.value
        if isinstance(node, ast.BinOp) and type(node.op) in allowed:
            return allowed[type(node.op)](eval_node(node.left), eval_node(node.right))
        if isinstance(node, ast.UnaryOp) and type(node.op) in allowed:
            return allowed[type(node.op)](eval_node(node.operand))
        raise ValueError("Unsupported expression")

    result = eval_node(ast.parse(expression, mode="eval").body)
    return {"tool": "calculate", "status": "Ok", "message": str(result), "data": [{"result": result}], "sources": []}

