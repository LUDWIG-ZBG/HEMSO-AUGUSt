# Query Planner
def query_planner_node(state: MultiAugustState):

    planer_llm = llm1

    human_messages = [m for m in state["messages"] if isinstance(m, HumanMessage)]

    #Fallback if no query
    if not human_messages:
        empty_plan = QueryPlan(
            original_query="",
            rewritten_query="",
            task_type="blandat",
            search_terms=[],
            answer_criteria=[],
        )
        return {
            "user_query": "",
            "query_plan": empty_plan.model_dump(),
            "ready_to_finalize": False,
        }

    #Fallback if no plan
    user_query = str(human_messages[-1].content).strip()

    fallback_plan = QueryPlan(
        original_query=user_query,
        rewritten_query=user_query,
        task_type="blandat",
        search_terms=[user_query] if user_query else [],
        answer_criteria=[
            "Svaret ska bygga enbart på explicit evidens från datarummet.",
            "Om uppgiften kräver siffror eller villkor måste dessa kunna hämtas från källorna.",
            "Om underlag saknas ska detta sägas tydligt.",
        ],
    )

    planner_prompt = """
        Returnera endast ett QueryPlan-objekt.
        Var konservativ.
        Behåll användarens intention exakt.
        Hitta inte på labels, dokument eller källor.
        Använd tomma listor hellre än att gissa.
        """


    try:
        planner_llm = planer_llm.with_structured_output(QueryPlan)
        raw_plan = planner_llm.invoke(
            [
                SystemMessage(content=planner_prompt),
                HumanMessage(content=user_query),
            ]
        )
        # Write plan to state
        if isinstance(raw_plan, QueryPlan):
            plan = raw_plan.model_copy(
                update={
                    "original_query": user_query,
                    "rewritten_query": (raw_plan.rewritten_query or user_query).strip(),
                    "search_terms": _normalize_list(raw_plan.search_terms),
                    "answer_criteria": _normalize_list(raw_plan.answer_criteria),
                }
            )
            print(plan)
        # If planner fails and plan is written as a dict
        elif isinstance(raw_plan, dict):
            plan = QueryPlan(
                original_query=user_query,
                rewritten_query=str(raw_plan.get("rewritten_query") or user_query).strip(),
                task_type=raw_plan.get("task_type") or "blandat",
                search_terms=_normalize_list(raw_plan.get("search_terms")),
                answer_criteria=_normalize_list(raw_plan.get("answer_criteria")),
            )
            print(plan)
        else:
            plan = fallback_plan
            #rint(plan)

    except Exception as e:
        print("Query planning failed:", repr(e))
        plan = fallback_plan
        print(plan)

    return {
        "user_query": user_query,
        "query_plan": plan.model_dump(),
        "ready_to_finalize": False,
    }

task_llm_with_tools = llm2.bind_tools(tools)

TASK_HANDLER_PROMPT_SHORT = """
Du är Task Handler i en Financial Due Diligence-agent.

Din uppgift är att styra informationsinhämtningen steg för steg tills det finns tillräcklig evidens för att besvara användarens fråga utifrån datarummet.

Regler:
- Endast clause_lookup och sheet_lookup skapar evidens.
- similarity_search, find_neighbours och sheet_labels är endast navigation.
- Om du endast har navigationsresultat och frågan kräver fakta, fortsätt med clause_lookup eller sheet_lookup.
- Upprepa inte samma tool call.
- Avsluta utan tool call endast om evidensen räcker, eller om det tydligt inte går att komma längre.
- Om ingen evidens finns ännu, börja normalt med similarity_search.
"""

# Task Handler
def task_handler_node(state: MultiAugustState):
    anti_loop_number = 5

    qp = _coerce_query_plan(state)

    human_messages = [m for m in state["messages"] if isinstance(m, HumanMessage)]
    user_query = state.get("user_query", "") or (
        str(human_messages[-1].content).strip() if human_messages else ""
    )

    existing_evidence = _normalize_evidence_items(state.get("evidence_items", []))
    latest_tool_results = _normalize_tool_result_records(
        state.get("latest_tool_results", []) or []
    )

    new_evidence = _collect_new_evidence_from_tool_results(
        tool_results=latest_tool_results,
        existing_items=existing_evidence,
    )
    all_evidence = existing_evidence + new_evidence

    # Anti-loop check
    recent_observations_for_loop = (state.get("tool_observations", []) or [])[-anti_loop_number:]
    no_new_evidence_recent = False

    if len(recent_observations_for_loop) >= anti_loop_number:
        last_n_results = recent_observations_for_loop[-anti_loop_number:]
        no_new_evidence_recent = all(
            (obs.get("result_count", 0) == 0)
            or (obs.get("status") in {"BLOCKED", "ERROR", "No"})
            for obs in last_n_results
        )

    if no_new_evidence_recent:
        print(f"[TASK_HANDLER] ANTI-LOOP TRIGGERED: senaste {anti_loop_number} observationerna gav ingen ny användbar signal")
        return {
            "messages": [],
            "evidence_items": new_evidence,
            "ready_to_finalize": True,
        }

    context = compact_state_for_task_handler(
        state=state,
        user_query=user_query,
        query_plan=qp,
        latest_tool_results=latest_tool_results,
        evidence_items=all_evidence,
    )

    response = task_llm_with_tools.invoke(
        [
            SystemMessage(content=TASK_HANDLER_PROMPT_SHORT),
            HumanMessage(content=json.dumps(context, ensure_ascii=False, default=str)),
        ]
    )

    has_tool_calls = bool(getattr(response, "tool_calls", None))
    has_real_evidence = any(e.tool in {"clause_lookup", "sheet_lookup"} for e in all_evidence)

    ready_to_finalize = not has_tool_calls

    # Important: avoid task_handler -> task_handler infinite loop
    if ready_to_finalize and not has_real_evidence:
        has_prior_tool_attempts = bool(state.get("tool_observations", []))

        if not has_prior_tool_attempts and user_query:
            response = AIMessage(
                content="",
                tool_calls=[
                    {
                        "name": "similarity_search",
                        "args": {"query_text": qp.rewritten_query or user_query},
                        "id": f"call_{uuid.uuid4().hex}",
                    }
                ],
            )
            ready_to_finalize = False
        else:
            # Let finalizer say evidence is insufficient
            ready_to_finalize = True

    return {
        "messages": [response],
        "evidence_items": new_evidence,
        "ready_to_finalize": ready_to_finalize,
    }

def tool_node(state: MultiAugustState):
    results: List[ToolMessage] = []
    compact_observations: List[Dict[str, Any]] = []
    latest_tool_results: List[ToolResultRecord] = []

    last_message = state["messages"][-1]
    tool_calls = getattr(last_message, "tool_calls", None) or []

    if not tool_calls:
        return {
            "messages": [],
            "tool_observations": [],
            "latest_tool_results": [],
        }

    for tool_call in tool_calls:
        tool_name = tool_call.get("name", "")
        tool_args = tool_call.get("args", {}) or {}
        tool_call_id = tool_call.get("id")

        if tool_name not in tools_by_name:
            error_raw = {
                "tool": tool_name,
                "status": "ERROR",
                "message": f"Okänt tool: {tool_name}",
                "data": [],
                "sources": [],
                "tool_args": tool_args,
            }

            compact = build_compact_tool_observation(error_raw, tool_name, tool_args)
            normalized_result = normalize_raw_tool_result(error_raw, tool_name, tool_args)
            normalized_result_dict = normalized_result.model_dump()

            results.append(
                ToolMessage(
                    content=json.dumps(normalized_result_dict, ensure_ascii=False, default=str),
                    tool_call_id=tool_call_id,
                )
            )
            compact_observations.append(compact.model_dump())
            latest_tool_results.append(normalized_result)
            continue

        resolved_tool_name, resolved_tool_args, validation_error = validate_or_route_tool_call(
            tool_name=tool_name,
            tool_args=tool_args,
            state=state,
        )

        recent_obs = state.get("tool_observations", [])[-8:]
        recent_signatures = {
            _tool_signature(obs.get("tool", ""), obs.get("tool_args", {}) or {})
            for obs in recent_obs
        }

        current_sig = _tool_signature(resolved_tool_name, resolved_tool_args)

        if current_sig in recent_signatures:
            blocked_raw = {
                "tool": resolved_tool_name,
                "status": "BLOCKED",
                "message": "Upprepat tool call blockerades för att undvika loop, pröva något annat.",
                "data": [],
                "sources": [],
                "tool_args": resolved_tool_args,
            }

            compact = build_compact_tool_observation(blocked_raw, resolved_tool_name, resolved_tool_args)
            normalized_result = normalize_raw_tool_result(blocked_raw, resolved_tool_name, resolved_tool_args)
            normalized_result_dict = normalized_result.model_dump()

            results.append(
                ToolMessage(
                    content=json.dumps(normalized_result_dict, ensure_ascii=False, default=str),
                    tool_call_id=tool_call_id,
                )
            )
            compact_observations.append(compact.model_dump())
            latest_tool_results.append(normalized_result)
            continue

        if validation_error is not None:
            validation_raw = {
                "tool": validation_error.tool,
                "status": validation_error.status,
                "message": validation_error.message,
                "data": [],
                "tool_args": validation_error.tool_args,
            }

            compact = build_compact_tool_observation(
                validation_raw,
                validation_error.tool,
                validation_error.tool_args,
            )
            normalized_result = normalize_raw_tool_result(
                validation_raw,
                validation_error.tool,
                validation_error.tool_args,
            )
            normalized_result_dict = normalized_result.model_dump()

            results.append(
                ToolMessage(
                    content=json.dumps(normalized_result_dict, ensure_ascii=False, default=str),
                    tool_call_id=tool_call_id,
                )
            )
            compact_observations.append(compact.model_dump())
            latest_tool_results.append(normalized_result)
            continue

        tool = tools_by_name[resolved_tool_name]

        try:
            raw_observation = tool.invoke(resolved_tool_args)

            if not isinstance(raw_observation, dict):
                raw_observation = {
                    "tool": resolved_tool_name,
                    "status": "ERROR",
                    "message": f"Tool returned non-dict output: {type(raw_observation).__name__}",
                    "data": [],
                    "sources": [],
                }

        except Exception as e:
            raw_observation = {
                "tool": resolved_tool_name,
                "status": "ERROR",
                "message": f"Tool execution failed: {repr(e)}",
                "data": [],
                "sources": [],
            }

        normalized_result = normalize_raw_tool_result(
            raw_observation,
            resolved_tool_name,
            resolved_tool_args,
        )
        normalized_result_dict = normalized_result.model_dump()

        compact = build_compact_tool_observation(
            normalized_result_dict,
            resolved_tool_name,
            resolved_tool_args,
        )

        results.append(
            ToolMessage(
                content=json.dumps(normalized_result_dict, ensure_ascii=False, default=str),
                tool_call_id=tool_call_id,
            )
        )

        compact_observations.append(compact.model_dump())
        latest_tool_results.append(normalized_result)

    return {
        "messages": results,
        "tool_observations": compact_observations,
        "latest_tool_results": latest_tool_results,
    }

def finalizer_node(state: MultiAugustState):

    answer_llm = llm3
    review_llm = llm4

    # Hämta bakgrund: QueryPlan och evidence items
    qp = _coerce_query_plan(state)
    user_query = state.get("user_query", "") or qp.original_query
    evidence_items = _normalize_evidence_items(state.get("evidence_items", []))

    evidence_context = "\n\n---\n\n".join(
        (
            f"[{e.evidence_id}]\n"
            f"Källa: {e.source.doc_id} | element: {e.source.element_id} | "
            f"sida: {e.source.page} | typ: {e.source.element_type}\n"
            f"Verktyg: {e.tool}\n"
            f"Context:\n{e.context}\n"
            f"Structured data:\n{json.dumps(e.structured_data or {}, ensure_ascii=False, default=str)}"
        )
        for e in evidence_items
    )[:15000]

    if not evidence_context.strip():
        evidence_context = "Ingen evidens har samlats in."

    # 1) Formulera svar till användarens query baserat på evidence_items
    answer_prompt = """
        Du är Finalizer i en Financial Due Diligence-agent. 
        Du ska besvara frågor från användare i professionell muntlig ton på svenska.
        Du får endast besvara frågorna utifrån evidensen nedan.

        Din uppgift:
        - Besvara användarens fråga enbart med stöd i evidensen nedan.
        - Använd endast explicit information från evidensen.
        - Skriv inte något som inte kan stödjas av evidensen.
        - Om evidensen inte räcker ska du säga det tydligt.
        - Varje faktapåstående ska ha minst en evidensreferens i formatet [E1] eller [E1, E2].
        - Använd endast evidens-ID:n som faktiskt finns i underlaget.
        - Skriv ett tydligt och professionellt slutligt svar på svenska i muntlig ton.
        """

    answer_response = answer_llm.invoke(
        [
            SystemMessage(content=answer_prompt),
            HumanMessage(
                content=f"""

        Query plan:
        - original_query: {user_query}
        - rewritten_query: {qp.rewritten_query}

        Evidens:
        {evidence_context}
        """
            ),
        ]
    )

    draft_answer = extract_final_text(answer_response.content)

    if not draft_answer:
        draft_answer = "Jag kan inte formulera ett säkert svar eftersom underlaget är otillräckligt."

    # 2) Criteria check against evidence_items
    #criteria_items = parse_criteria_items(krav_lista)
    review_result = CriteriaReviewResult(findings=[])

    try:
        review_llm = review_llm.with_structured_output(CriteriaReviewResult)
        raw_review_result = review_llm.invoke(
            [
                SystemMessage(
                    content=(
                            "Du är sista steget i en FDD-agent och ska jämföra en 'krav-lista' mot 'evidens'.\n"
                            "Bedöm endast punkter från 'krav-lista' som besvaras i 'evidens'.\n"
                            "För varje relevant krav ska du sätta status till 'Uppfyllt' eller 'Ej uppfyllt'.\n"
                            "Varje finding ska ha kort motivation och supporting_evidence_ids när sådana finns.\n"
                            "Om inget krav besvaras, returnera en tom lista."
                        )
                ),
                HumanMessage(
                    content=f"""
                krav-lista:
                {krav_lista}

                Evidens:
                {evidence_context}
                """
                ),
            ]
        )

        if raw_review_result is None:
            review_result = CriteriaReviewResult(findings=[])
        elif isinstance(raw_review_result, CriteriaReviewResult):
            review_result = raw_review_result
        elif isinstance(raw_review_result, dict):
            review_result = CriteriaReviewResult(**raw_review_result)
        else:
            review_result = CriteriaReviewResult(findings=[])

    except Exception as e:
        print("Review parsing failed:", repr(e))
        review_result = CriteriaReviewResult(findings=[])

    # 3) Keep only evidence actually cited in the final answer
    valid_evidence_ids = {e.evidence_id for e in evidence_items}
    used_ids = [eid for eid in extract_evidence_ids(draft_answer) if eid in valid_evidence_ids]

    all_evidence = mark_used_evidence(evidence_items, used_ids)
    used_evidence = keep_only_used_evidence(all_evidence)

    if not used_ids and evidence_items:
        citation_repair_prompt = """
        Lägg till evidenshänvisningar i formatet [E1] eller [E1, E2] i svaret.
        Ändra inte innehållet mer än nödvändigt.
        Använd endast evidens-ID som finns i underlaget.
        """

        repair_response = answer_llm.invoke(
            [
                SystemMessage(content=citation_repair_prompt),
                HumanMessage(
                    content=f"Svar utan korrekt citering:\n{draft_answer}\n\nTillgänglig evidens:\n{evidence_context}"
                ),
            ]
        )
        draft_answer = extract_final_text(repair_response.content)
        used_ids = [eid for eid in extract_evidence_ids(draft_answer) if eid in valid_evidence_ids]

    effective_evidence = used_evidence

    used_sources = dedupe_sources([e.source for e in effective_evidence])
    grouped_sources = group_sources_by_page(used_sources)
    grouped_evidence = group_evidence_by_page(effective_evidence)

    final_payload = MultiFinalAnswer(
        Answer=draft_answer,
        Review=review_result.findings,
        EvidenceTrail=effective_evidence,
        query_plan=qp,
    )

    if final_payload.Review:
        review_text = "\n".join(
            (
                f"- {item.criterion}: {item.status} – {item.motivation}"
                + (
                    f" | evidens: [{', '.join(item.supporting_evidence_ids)}]"
                    if item.supporting_evidence_ids else ""
                )
            )
            for item in final_payload.Review
        )
    else:
        review_text = "- Inga kriterier kunde explicit bedömas utifrån evidensen."

    evidence_text_output = (
        "\n".join(
            f"- {e['doc_id']} | page {e['page']} | evidence item [{', '.join(e['evidence_ids'])}] "
            for e in grouped_evidence
        )
        or "- Ingen explicit evidens citerades i svaret"
    )

    final_text = (
        f"Svar:\n"
        f"{final_payload.Answer}\n\n"
        f"Bedömning mot kriterielistan:\n"
        f"{review_text}\n\n"
        f"Evidensspår:\n"
        f"{evidence_text_output}\n\n"
        #f"Källor:\n"
        #f"{source_text}"
    )

    return {
        "final_output": final_payload.model_dump(),
        "messages": [AIMessage(content=final_text)],
        "ready_to_finalize": True,
    }

# 6) Routing
def should_continue(state: MultiAugustState):
    if state.get("ready_to_finalize"):
        return "finalizer"

    last = state["messages"][-1]
    if getattr(last, "tool_calls", None):
        return "tool_node"

    return "task_handler"


# 7) Build graph
