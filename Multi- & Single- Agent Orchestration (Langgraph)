# Navigation helpers
def empty_navigation_memory() -> Dict[str, Any]:
    return {
        "searches": [],      # recent similarity_search queries
        "elements": {},      # element_id -> compact metadata
        "sheets": {},        # element_id -> sheet labels/profile
        "neighbours": {},    # seed_element_id -> neighbour ids
    }


def _cap_dict(d: Dict[str, Any], max_items: int) -> Dict[str, Any]:
    if not d:
        return {}
    return dict(list(d.items())[-max_items:])


def _dedupe_recent_searches(searches: List[Dict[str, Any]], max_items: int = 12) -> List[Dict[str, Any]]:
    out_reversed = []
    seen = set()

    for item in reversed(searches or []):
        if not isinstance(item, dict):
            continue

        key = (
            item.get("tool"),
            item.get("query_text"),
        )

        if key in seen:
            continue

        seen.add(key)
        out_reversed.append(item)

    return list(reversed(out_reversed))[-max_items:]



# Class and state Helpers
def merge_navigation_memory(left: Dict[str, Any], right: Dict[str, Any]) -> Dict[str, Any]:
    """
    Reducer for LangGraph state.
    Keeps navigation memory small and deterministic.
    This is NOT evidence; it is only for choosing future tool calls.
    """
    left = left or {}
    right = right or {}

    searches = (
        list(left.get("searches", []) or [])
        + list(right.get("searches", []) or [])
    )

    elements = {
        **(left.get("elements", {}) or {}),
        **(right.get("elements", {}) or {}),
    }

    sheets = {
        **(left.get("sheets", {}) or {}),
        **(right.get("sheets", {}) or {}),
    }

    neighbours = {
        **(left.get("neighbours", {}) or {}),
        **(right.get("neighbours", {}) or {}),
    }

    return {
        "searches": _dedupe_recent_searches(searches, max_items=12),
        "elements": _cap_dict(elements, max_items=40),
        "sheets": _cap_dict(sheets, max_items=12),
        "neighbours": _cap_dict(neighbours, max_items=20),
    }


