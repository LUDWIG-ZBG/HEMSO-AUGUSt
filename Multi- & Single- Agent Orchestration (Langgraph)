def _as_bbox_list(value):
    """
    Keeps bbox handling stable whether DBSQL returns ARRAY, tuple, list, or JSON string.
    """
    if value is None:
        return None
    if isinstance(value, list):
        return value
    if isinstance(value, tuple):
        return list(value)
    if isinstance(value, str):
        try:
            parsed = json.loads(value)
            return list(parsed) if isinstance(parsed, (list, tuple)) else None
        except Exception:
            return None
    try:
        return list(value)
    except Exception:
        return None

