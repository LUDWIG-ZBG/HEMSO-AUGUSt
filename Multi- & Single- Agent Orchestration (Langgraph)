# Helper
def _bbox_val(bbox, idx, default=float("inf")):
    if bbox is None:
        return default
    try:
        value = bbox[idx]
        return float(value) if value is not None else default
    except (IndexError, TypeError, ValueError):
        return default

# Helper sorters
def pdf_sort(items):
    """
    items = list of row dictionaries for ONE pdf document.
    Returns a list of element_id values sorted by:
    page -> y1 -> x2 -> element_id
    """
    return [
        item["element_id"]
        for item in sorted(
            items,
            key=lambda item: (
                item["page"],
                _bbox_val(item["bbox_xyxy"], 1),   # y1
                _bbox_val(item["bbox_xyxy"], 0),   # x2
                item["element_id"],                # deterministic tie-breaker
            ),
        )
    ]


def xlsx_sort(items):
    """
    items = list of row dictionaries for ONE spreadsheet document.
    Returns a list of element_id values sorted by:
    page -> element_id
    """
    return [
        item["element_id"]
        for item in sorted(
            items,
            key=lambda item: (
                item["page"],         # page used as sheet order
                item["element_id"],   # deterministic tie-breaker
            ),
        )
    ]


