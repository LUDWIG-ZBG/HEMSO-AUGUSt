def _make_source_ref_strings(sources: List[Any]) -> List[str]:
    out = []
    seen = set()

    for s in sources or []:
        if isinstance(s, dict):
            doc_id = s.get("doc_id")
            element_id = s.get("element_id")
            page = s.get("page")
            element_type = s.get("element_type")
        else:
            doc_id = getattr(s, "doc_id", None)
            element_id = getattr(s, "element_id", None)
            page = getattr(s, "page", None)
            element_type = getattr(s, "element_type", None)

        ref = f"{doc_id}|{element_id}|{page}|{element_type}"
        if ref not in seen:
            seen.add(ref)
            out.append(ref)

    return out


