def build_evidence_from_tool_result(
    tool_result: ToolResultRecord,
    existing_items: List[EvidenceItem],
) -> List[EvidenceItem]:
    if not tool_result.evidence_candidate:
        return []

    out = []

    tool_name = tool_result.tool
    data = tool_result.data
    sources = tool_result.sources

    next_id_num = len(existing_items) + 1
    evidence_offset = 0

    for item in data:
        source = None
        context = ""
        structured_data = None

        if tool_name == "clause_lookup":
            content = str(item.get("content", "") or "").strip()
            if not content:
                continue

            source = SourceRef(
                doc_id=item.get("doc_id"),
                element_id=item.get("element_id"),
                page=item.get("page"),
                element_type=item.get("element_type"),
            )

            context = content
            structured_data = {
                "element_type": item.get("element_type"),
            }

        elif tool_name == "sheet_lookup":
            value = item.get("Value")
            row_label = item.get("row_label")
            column_label = item.get("column_label")

            if value is None and not row_label and not column_label:
                continue

            first_source = sources[0] if sources else None
            if isinstance(first_source, dict):
                source = SourceRef(**first_source)
            else:
                source = first_source

            if not source:
                continue

            context = f"Value '{value}' for row '{row_label}' and column '{column_label}'."
            structured_data = item

        else:
            continue

        out.append(
            EvidenceItem(
                evidence_id=f"E{next_id_num + evidence_offset}",
                source=source,
                context=context,
                tool=tool_name,
                structured_data=structured_data,
            )
        )
        evidence_offset += 1

    return out


def _collect_new_evidence_from_tool_results(
    tool_results: List[Any],
    existing_items: List[EvidenceItem],
) -> List[EvidenceItem]:
    existing_items = _normalize_evidence_items(existing_items)
    tool_results = _normalize_tool_result_records(tool_results)

    seen = {_evidence_key(e) for e in existing_items}

    working_existing = list(existing_items)
    new_items = []

    for result in tool_results:
        try:
            candidates = build_evidence_from_tool_result(result, working_existing)
        except Exception as e:
            print("Evidence build failed:", repr(e))
            continue

        for candidate in candidates:
            key = _evidence_key(candidate)
            if key in seen:
                continue

            seen.add(key)
            new_items.append(candidate)
            working_existing.append(candidate)

    return new_items

def _coerce_query_plan(state: MultiAugustState) -> QueryPlan:
    raw_plan = state.get("query_plan") or {}
    user_query = state.get("user_query", "") or ""

    if isinstance(raw_plan, QueryPlan):
        return raw_plan

    if isinstance(raw_plan, dict):
        try:
            return QueryPlan(**raw_plan)
        except Exception:
            pass

    return QueryPlan(
        original_query=user_query,
        rewritten_query=user_query,
        task_type="blandat",
        search_terms=[user_query] if user_query else [],
        answer_criteria=[],
    )


def _normalize_evidence_items(items: List[Any]) -> List[EvidenceItem]:
    out = []
    for item in items or []:
        if isinstance(item, EvidenceItem):
            out.append(item)
        elif isinstance(item, dict):
            out.append(EvidenceItem(**item))
    return out


def _evidence_key(e: EvidenceItem) -> tuple:
    return (
        e.source.doc_id,
        e.source.element_id,
        e.source.page,
        e.tool,
        e.context.strip(),
    )

