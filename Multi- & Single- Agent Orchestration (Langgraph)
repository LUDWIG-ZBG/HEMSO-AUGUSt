class FinalAnswerText(BaseModel):
    Answer: str = Field(
        ...,
        description=(
            "Besvara frågan så noggrant som möjligt med hjälp av information du kan hitta i datarummet. "
            "Varje faktapåstående måste ha minst en evidensreferens i formatet [E1] eller [E1, E2]. "
            "Om du inte hittar relevant information ska du uttrycka det tydligt."
        ),
    )


def render_final_message(final_output: Dict[str, Any]) -> str:
    answer = final_output.get("Answer", "") or ""
    evidence_trail = final_output.get("EvidenceTrail", []) or []

    grouped = group_evidence_by_page(evidence_trail)

    if not grouped:
        return answer

    source_lines = []
    for g in grouped:
        evid = ", ".join(g.get("evidence_ids", []))
        page = g.get("page")
        doc_id = g.get("doc_id")
        page_text = f"page {page}" if page is not None else "page ?"
        source_lines.append(f"{doc_id}, evidence item [{evid}], {page_text}")

    return answer + "\n\nSources:\n" + "\n".join(source_lines)

# Agent
def llm_call(state: SingleAugustState):
    system = SystemMessage(content=prompt)

    response = llm5_with_tools.invoke([system] + state["messages"])

    if getattr(response, "tool_calls", None):
        return {"messages": [response]}

    evidence_items = [
        EvidenceItem(**e) if isinstance(e, dict) else e
        for e in state.get("evidence_items", [])
    ]

    user_query = state.get("query", "") or ""
    if not user_query:
        for m in state.get("messages", []):
            if isinstance(m, HumanMessage):
                user_query = m.content
                break

    evidence_block_parts = []
    for e in evidence_items:
        citation = (e.structured_data or {}).get("citation")
        citation_part = f" | {citation}" if citation else ""

        evidence_block_parts.append(
            f"[{e.evidence_id}] "
            f"{e.source.doc_id} | {e.source.element_id} | page {e.source.page}{citation_part}\n"
            f"{e.context}"
        )

    evidence_block = "\n\n".join(evidence_block_parts).strip()
    if not evidence_block:
        evidence_block = "Ingen evidens har hämtats från verktygen."

    try:
        final_answer_response = llm5.invoke(
            [
                SystemMessage(
                    content=(
                        "Du skriver slutsvaret för en Financial Due Diligence-agent. "
                        "Svara endast med stöd i evidensen. "
                        "Varje faktapåstående måste ha minst en evidensreferens i formatet [E1] eller [E1, E2]. "
                        "Använd endast evidens-ID:n som faktiskt finns i underlaget. "
                        "Om underlag saknas ska du säga det tydligt. "
                        "Svara endast med själva slutsvaret som vanlig text, inte som JSON."
                    )
                ),
                HumanMessage(
                    content=(
                        f"Fråga:\n{user_query}\n\n"
                        f"Evidens:\n{evidence_block}"
                    )
                ),
            ]
        )

        answer_text = extract_final_text(final_answer_response).strip()

    except Exception as e:
        print("[FINAL ANSWER ERROR]", repr(e))
        answer_text = ""

    if not answer_text:
        answer_text = (
            "Jag kunde inte generera ett stabilt slutsvar från modellen. "
            "Underlaget kan vara otillräckligt eller svaret gick inte att tolka."
        )

    used_ids = extract_evidence_ids(answer_text)
    marked_evidence = mark_used_evidence(evidence_items, used_ids)
    used_evidence = keep_only_used_evidence(marked_evidence)

    final_sources = dedupe_sources([
        SourceRef(
            doc_id=e.source.doc_id,
            element_id=e.source.element_id,
            page=e.source.page,
            element_type=e.source.element_type,
        )
        for e in used_evidence
    ])

    final_output_obj = SingleFinalAnswer(
        Answer=answer_text,
        Sources=final_sources,
        EvidenceTrail=used_evidence,
    )

    final_output = final_output_obj.model_dump(mode="json")
    final_message = AIMessage(
        content=render_final_message(final_output),
        response_metadata=getattr(final_answer_response, "response_metadata", {}),
        usage_metadata=getattr(final_answer_response, "usage_metadata", None),
        additional_kwargs=getattr(final_answer_response, "additional_kwargs", {}),
    )

    return {
        "messages": [final_message],
        "sources": final_sources,
        "evidence_items": marked_evidence,
        "final_output": final_output,
    }

# Tool node
def tool_node(state: SingleAugustState):
    results = []
    new_sources = []
    new_evidence = []

    existing_evidence = [
        EvidenceItem(**e) if isinstance(e, dict) else e
        for e in state.get("evidence_items", [])
    ]

    for tool_call in state["messages"][-1].tool_calls:
        tool_name = tool_call["name"]
        tool_args = tool_call["args"]

        # Validera/routa enligt din tidigare kod
        validated_tool_name, validated_tool_args, routed_observation = validate_or_route_tool_call(
            tool_name=tool_name,
            tool_args=tool_args,
            state={
                "messages": state.get("messages", []),
                "user_query": state.get("query", ""),
                "query_plan": {},
                "tool_observations": [],
                "evidence_items": state.get("evidence_items", []),
                "ready_to_finalize": False,
                "final_output": state.get("final_output", {}),
            },
        )

        if routed_observation is not None:
            observation = routed_observation.model_dump()
        else:
            observation = safe_invoke_tool(validated_tool_name, validated_tool_args)

        # Lägg till tool-svar i messages så LLM kan läsa det
        results.append(
            ToolMessage(
                content=json.dumps(observation, ensure_ascii=False, default=str),
                tool_call_id=tool_call["id"],
            )
        )

        # Samla sources
        obs_sources = [
            SourceRef(**s) if isinstance(s, dict) else s
            for s in observation.get("sources", [])
        ]
        new_sources.extend(obs_sources)

        # Bygg evidens via din befintliga kompatibla helper
        observation_for_evidence = dict(observation)
        observation_for_evidence["tool_args"] = validated_tool_args

        built_items = build_evidence_from_observation(
            observation=observation_for_evidence,
            existing_items=existing_evidence + new_evidence,
        )

        new_evidence.extend(built_items)

    return {
        "messages": results,
        "sources": dedupe_sources(state.get("sources", []) + new_sources),
        "evidence_items": existing_evidence + new_evidence,
    }

