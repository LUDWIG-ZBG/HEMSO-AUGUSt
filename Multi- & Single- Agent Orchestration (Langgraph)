builder.add_edge("query_planner", "task_handler")
builder.add_conditional_edges(
    "task_handler",
    should_continue,
    {
        "tool_node": "tool_node",
        "finalizer": "finalizer",
    },
)
builder.add_edge("tool_node", "task_handler")
builder.add_edge("finalizer", END)
