@tool
def similarity_search(query_text: str):
    """Sök i datarummet efter de element som är mest relevanta för användarens fråga. Detta är normalt första verktyget att använda. Returnerar relevanta element med metadata, inklusive: doc_id, element_id, page, summary_text och element_type."""
    number_of_results = 8

    vsc = VectorSearchClient(disable_notice=True,
        credential_strategy= CredentialStrategy.MODEL_SERVING_USER_CREDENTIALS
    )
    index = vsc.get_index(
        endpoint_name="due_diligence",
        index_name=VectorSearchIndex
    )
    
    raw_results = index.similarity_search(
        query_text=query_text,
        columns=[
            "doc_id",
            "element_id",
            "page",
            "summary_text",
            "element_type"
        ],
        num_results=number_of_results,
        query_type= "hybrid",
        reranker=DatabricksReranker(
            columns_to_rerank=["summary_text"]
        )
    )
    # turn raw_results into a dictionary results
    cols = [c["name"] for c in raw_results.get("manifest", {}).get("columns", [])]
    rows = raw_results.get("result", {}).get("data_array", [])
    results = [dict(zip(cols, row)) for row in rows]

    # setup response
    nr_results = len(results)
    status = "Ok" if nr_results > 0 else "Inga resultat hittades"
    message = f"{nr_results} liknande chunks hittades i datarummet"

    sources = [
        SourceRef(
            doc_id=r.get("doc_id"),
            element_id=r.get("element_id"),
            page=r.get("page"),
            element_type=r.get("element_type"),
        )
        for r in results
    ]

    return ToolResponse(
        tool="similarity_search",
        status=status,
        message=message,
        data= results,
        sources= sources,
    ).model_dump()


@tool
def find_neighbours(element_id: str, eps: int):
    """Hämta närliggande element_id runt ett känt element_id."""

    for doc in element_neighbour_list:
        elements = doc["elements"]
        if element_id in elements:
            idx = elements.index(element_id)
            start = max(0, idx - eps)
            end = min(len(elements), idx + eps + 1)
            neighbour_ids = elements[start:end]

            sources = [
                SourceRef(
                    doc_id=doc["doc_id"],
                    element_id=eid,
                    page=None,
                    element_type=None,
                )
                for eid in neighbour_ids
            ]

            data = [
                {"element_id": eid}
                for eid in neighbour_ids
            ]

            return ToolResponse(
                tool="find_neighbours",
                status="Ok",
                message=f"{len(neighbour_ids)} grannar hittades",
                data=data,
                sources=sources,
            ).model_dump()

    return ToolResponse(
        tool="find_neighbours",
        status="No",
        message=f"element_id '{element_id}' hittades inte",
        data=[],
        sources=[],
    ).model_dump()


