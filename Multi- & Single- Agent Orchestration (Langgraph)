def _normalize_tool_status(value: Any) -> Literal["Ok", "No", "ERROR", "BLOCKED"]:
    s = str(value or "").strip()

    if s in {"Ok", "No", "ERROR", "BLOCKED"}:
        return s

    if s in {"Inga resultat hittades", "No results", "Not found"}:
        return "No"

    return "ERROR"


def _normalize_tool_result_records(items: List[Any]) -> List[ToolResultRecord]:
    out = []

    for item in items or []:
        if isinstance(item, ToolResultRecord):
            out.append(item)
        elif isinstance(item, dict):
            out.append(ToolResultRecord(**item))

    return out

