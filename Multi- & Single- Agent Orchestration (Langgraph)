def format_sheet_evidence(item: Dict[str, Any]) -> tuple[str, Optional[str], Dict[str, Any]]:
    row_label = item.get("row_label")
    column_label = item.get("column_label")
    fallback_label = item.get("label")
    value = item.get("Value")
    row_nr = item.get("Row")
    col_letter = item.get("Column_letter")
    col_nr = item.get("Column")

    cell_ref = None
    if col_letter and row_nr:
        cell_ref = f"{col_letter}{row_nr}"

    if row_label and column_label:
        content = f"Extracted value '{value}' for row '{row_label}' and column '{column_label}'."
    elif fallback_label:
        content = f"Extracted value '{value}' for label '{fallback_label}'."
    else:
        content = f"Extracted value '{value}'."

    citation_parts = []
    if cell_ref:
        citation_parts.append(f"cell {cell_ref}")
    if row_nr:
        citation_parts.append(f"row {row_nr}")
    if col_nr:
        citation_parts.append(f"column {col_nr}")

    citation = ", ".join(citation_parts) if citation_parts else None

    return (
        content,
        citation,
        {
            "row_label": row_label,
            "column_label": column_label,
            "label": fallback_label,
            "value": value,
            "value_num": item.get("Value_num"),
            "row": row_nr,
            "column": col_nr,
            "column_letter": col_letter,
        },
    )

