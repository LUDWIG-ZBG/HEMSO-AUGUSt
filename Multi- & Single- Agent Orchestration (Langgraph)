def _sheet_col_letter(col_nr: int) -> str:
    col_nr = int(col_nr)
    out = []
    while col_nr > 0:
        col_nr, rem = divmod(col_nr - 1, 26)
        out.append(chr(ord("A") + rem))
    return "".join(reversed(out)) or "A"


def _sheet_norm(value: Any) -> str:
    if value is None:
        return ""
    s = str(value)
    s = unicodedata.normalize("NFKD", s)
    s = "".join(ch for ch in s if not unicodedata.combining(ch))
    s = s.lower()
    s = s.replace("\u00a0", " ")
    s = re.sub(r"[%€$£]", " ", s)
    s = re.sub(r"[\(\)\[\]\{\}:;,_/\\|]+", " ", s)
    s = re.sub(r"\s+", " ", s).strip()
    return s


def _sheet_is_empty(value: Any) -> bool:
    return value is None or str(value).strip() == ""


def _sheet_parse_number(value: Any) -> Optional[float]:
    if value is None:
        return None

    if isinstance(value, (int, float)) and not isinstance(value, bool):
        try:
            return float(value)
        except Exception:
            return None

    s = str(value).strip()
    if not s:
        return None

    negative = False
    if s.startswith("(") and s.endswith(")"):
        negative = True
        s = s[1:-1].strip()

    s = s.replace("\u00a0", " ").replace(" ", "")
    s = s.replace("%", "")
    s = re.sub(r"[^0-9,.\-]", "", s)

    if not s or s in {"-", ".", ",", "-.", "-,"}:
        return None

    if "," in s and "." in s:
        if s.rfind(",") > s.rfind("."):
            s = s.replace(".", "").replace(",", ".")
        else:
            s = s.replace(",", "")
    elif "," in s:
        if s.count(",") == 1 and len(s.split(",")[-1]) in {1, 2, 3}:
            s = s.replace(",", ".")
        else:
            s = s.replace(",", "")
    elif "." in s and s.count(".") > 1:
        s = s.replace(".", "")

    try:
        num = float(s)
        return -num if negative else num
    except Exception:
        return None


def _sheet_is_time_like_label(norm_label: str) -> bool:
    if not norm_label:
        return False

    if norm_label in SHEET_MONTH_WORDS:
        return True

    if re.fullmatch(r"(19|20)\d{2}", norm_label):
        return True

    if re.fullmatch(r"(19|20)\d{2}\s*-\s*(0?[1-9]|1[0-2])", norm_label):
        return True

    if re.fullmatch(r"(q[1-4]|kv[1-4])", norm_label):
        return True

    return False


def _sheet_load_payload(raw_table: Any) -> Dict[str, Any]:
    payload = raw_table

    if isinstance(payload, str):
        payload = payload.strip()
        if not payload:
            raise ValueError("raw_table is empty")
        payload = json.loads(payload)

    if not isinstance(payload, dict):
        raise ValueError("raw_table is not a JSON object")

    schema_version = payload.get("schema_version")
    if schema_version not in SHEET_LOOKUP_SUPPORTED_SCHEMAS:
        raise ValueError(
            f"sheet_lookup requires anatomy JSON with schema_version in "
            f"{sorted(SHEET_LOOKUP_SUPPORTED_SCHEMAS)}, got: {schema_version}"
        )

    return payload


def _sheet_region_by_id(payload: Dict[str, Any]) -> Dict[str, Dict[str, Any]]:
    out = {}
    for region in payload.get("table_regions", []) or []:
        region_id = region.get("region_id")
        if region_id:
            out[str(region_id)] = region
    return out


def _sheet_rows_by_nr(region: Dict[str, Any]) -> Dict[int, Dict[str, Any]]:
    out = {}
    for row in region.get("rows", []) or []:
        row_nr = row.get("row_nr")
        if row_nr is not None:
            out[int(row_nr)] = row
    return out


def _sheet_cols_by_nr(region: Dict[str, Any]) -> Dict[int, Dict[str, Any]]:
    out = {}
    for col in region.get("columns", []) or []:
        col_nr = col.get("column_nr")
        if col_nr is not None:
            out[int(col_nr)] = col
    return out


def _sheet_cells_by_rc(region: Dict[str, Any]) -> Dict[Tuple[int, int], Dict[str, Any]]:
    out = {}
    for cell in region.get("cells", []) or []:
        row_nr = cell.get("row")
        col_nr = cell.get("column")
        if row_nr is None or col_nr is None:
            continue
        out[(int(row_nr), int(col_nr))] = cell
    return out


def _sheet_primary_row_label(region: Dict[str, Any], row_nr: int) -> Optional[str]:
    row_meta = _sheet_rows_by_nr(region).get(int(row_nr), {}) or {}
    candidates = row_meta.get("label_candidates") or []
    for cand in candidates:
        text = str(cand).strip()
        if text:
            return text

    norm_candidates = row_meta.get("normalized_label_candidates") or []
    for cand in norm_candidates:
        text = str(cand).strip()
        if text:
            return text

    return None


def _sheet_column_label(region: Dict[str, Any], col_nr: int) -> Optional[str]:
    col_meta = _sheet_cols_by_nr(region).get(int(col_nr), {}) or {}
    label = col_meta.get("label")
    if label is not None and str(label).strip():
        return str(label).strip()

    norm_label = col_meta.get("normalized_label")
    if norm_label is not None and str(norm_label).strip():
        return str(norm_label).strip()

    return None


def _sheet_dedupe_hits(hits: List[Dict[str, Any]], axis: str) -> List[Dict[str, Any]]:
    out = []
    seen = set()

    for hit in hits or []:
        if not isinstance(hit, dict):
            continue

        if axis == "row":
            key = (
                hit.get("region_id"),
                hit.get("row_nr"),
                hit.get("target_label"),
            )
        else:
            key = (
                hit.get("region_id"),
                hit.get("column_nr"),
                hit.get("target_label"),
            )

        if key in seen:
            continue

        seen.add(key)
        out.append(hit)

    return out


def _sheet_choose_axis(
    norm_label: str,
    row_hits: List[Dict[str, Any]],
    col_hits: List[Dict[str, Any]],
    region_by_id: Dict[str, Dict[str, Any]],
) -> Optional[str]:
    if row_hits and not col_hits:
        return "row"
    if col_hits and not row_hits:
        return "column"
    if not row_hits and not col_hits:
        return None

    row_data_hits = False
    row_header_hits = False
    for hit in row_hits:
        region = region_by_id.get(str(hit.get("region_id")))
        if not region:
            continue
        row_meta = _sheet_rows_by_nr(region).get(int(hit.get("row_nr")), {}) or {}
        kind = str(row_meta.get("kind") or "")
        if kind == "data_row":
            row_data_hits = True
        if kind == "header_row":
            row_header_hits = True

    col_data_hits = False
    col_header_hits = False
    for hit in col_hits:
        region = region_by_id.get(str(hit.get("region_id")))
        if not region:
            continue
        col_meta = _sheet_cols_by_nr(region).get(int(hit.get("column_nr")), {}) or {}
        kind = str(col_meta.get("kind") or "")
        if kind == "data_column":
            col_data_hits = True
        if kind == "header_column":
            col_header_hits = True

    if _sheet_is_time_like_label(norm_label):
        return "column"

    if row_data_hits and not col_data_hits:
        return "row"

    if col_data_hits and not row_data_hits:
        return "column"

    if row_header_hits and col_data_hits:
        return "column"

    if col_header_hits and row_data_hits:
        return "row"

    if len(norm_label.split()) >= 2:
        return "row"

    return "column"


def _sheet_resolve_hits(
    target_labels: List[str],
    payload: Dict[str, Any],
) -> Tuple[List[Dict[str, Any]], List[Dict[str, Any]], List[str]]:
    lookup_index = payload.get("lookup_index", {}) or {}
    row_lookup = lookup_index.get("row_label_map", {}) or {}
    col_lookup = lookup_index.get("column_label_map", {}) or {}
    region_by_id = _sheet_region_by_id(payload)

    resolved_rows = []
    resolved_cols = []
    unmatched = []

    seen_norm_labels = set()

    for target_label in target_labels or []:
        norm_label = _sheet_norm(target_label)
        if not norm_label or norm_label in seen_norm_labels:
            continue
        seen_norm_labels.add(norm_label)

        raw_row_hits = row_lookup.get(norm_label, []) or []
        raw_col_hits = col_lookup.get(norm_label, []) or []

        row_hits = []
        for hit in raw_row_hits:
            if not isinstance(hit, dict):
                continue
            region_id = str(hit.get("region_id") or "")
            row_nr = hit.get("row_nr")
            if not region_id or row_nr is None or region_id not in region_by_id:
                continue
            row_hits.append({
                "region_id": region_id,
                "row_nr": int(row_nr),
                "label": hit.get("label"),
                "target_label": target_label,
                "normalized_target_label": norm_label,
            })

        col_hits = []
        for hit in raw_col_hits:
            if not isinstance(hit, dict):
                continue
            region_id = str(hit.get("region_id") or "")
            col_nr = hit.get("column_nr")
            if not region_id or col_nr is None or region_id not in region_by_id:
                continue
            col_hits.append({
                "region_id": region_id,
                "column_nr": int(col_nr),
                "column_letter": hit.get("column_letter"),
                "label": hit.get("label"),
                "target_label": target_label,
                "normalized_target_label": norm_label,
            })

        axis = _sheet_choose_axis(
            norm_label=norm_label,
            row_hits=row_hits,
            col_hits=col_hits,
            region_by_id=region_by_id,
        )

        if axis == "row":
            resolved_rows.extend(_sheet_dedupe_hits(row_hits, axis="row"))
        elif axis == "column":
            resolved_cols.extend(_sheet_dedupe_hits(col_hits, axis="column"))
        else:
            unmatched.append(target_label)

    resolved_rows = sorted(
        resolved_rows,
        key=lambda x: (x["region_id"], x["row_nr"], _sheet_norm(x.get("target_label"))),
    )
    resolved_cols = sorted(
        resolved_cols,
        key=lambda x: (x["region_id"], x["column_nr"], _sheet_norm(x.get("target_label"))),
    )

    return resolved_rows, resolved_cols, unmatched


def _sheet_make_item(
    region: Dict[str, Any],
    row_nr: int,
    col_nr: int,
    row_label: Optional[str],
    column_label: Optional[str],
    fallback_label: Optional[str],
    match_type: str,
    matched_labels: List[str],
) -> Optional[Dict[str, Any]]:
    cells_by_rc = _sheet_cells_by_rc(region)
    cols_by_nr = _sheet_cols_by_nr(region)

    cell = cells_by_rc.get((int(row_nr), int(col_nr)))
    if not cell:
        return None

    value = cell.get("value")
    if _sheet_is_empty(value):
        return None

    col_meta = cols_by_nr.get(int(col_nr), {}) or {}
    column_letter = (
        cell.get("column_letter")
        or col_meta.get("column_letter")
        or _sheet_col_letter(int(col_nr))
    )

    item = {
        "row_label": row_label,
        "column_label": column_label,
        "label": fallback_label,
        "Value": value,
        "Value_num": cell.get("value_num", _sheet_parse_number(value)),
        "Row": int(row_nr),
        "Column": int(col_nr),
        "Column_letter": column_letter,
        "region_id": region.get("region_id"),
        "match_type": match_type,
        "matched_labels": matched_labels,
    }

    return item


def _sheet_collect_intersections(
    region: Dict[str, Any],
    row_hits: List[Dict[str, Any]],
    col_hits: List[Dict[str, Any]],
) -> List[Dict[str, Any]]:
    out = []

    for row_hit in row_hits:
        row_nr = int(row_hit["row_nr"])
        row_label = row_hit.get("label") or _sheet_primary_row_label(region, row_nr)

        for col_hit in col_hits:
            col_nr = int(col_hit["column_nr"])
            column_label = col_hit.get("label") or _sheet_column_label(region, col_nr)

            item = _sheet_make_item(
                region=region,
                row_nr=row_nr,
                col_nr=col_nr,
                row_label=row_label,
                column_label=column_label,
                fallback_label=None,
                match_type="intersection",
                matched_labels=[row_hit.get("target_label"), col_hit.get("target_label")],
            )
            if item:
                out.append(item)

    return out


def _sheet_collect_row_scan(
    region: Dict[str, Any],
    row_hits: List[Dict[str, Any]],
) -> List[Dict[str, Any]]:
    out = []
    cols_by_nr = _sheet_cols_by_nr(region)

    candidate_cols = sorted(
        col_nr
        for col_nr, meta in cols_by_nr.items()
        if str(meta.get("kind") or "") != "header_column"
    )

    if not candidate_cols:
        candidate_cols = sorted(cols_by_nr.keys())

    for row_hit in row_hits:
        row_nr = int(row_hit["row_nr"])
        row_label = row_hit.get("label") or _sheet_primary_row_label(region, row_nr)

        for col_nr in candidate_cols:
            column_label = _sheet_column_label(region, col_nr)

            item = _sheet_make_item(
                region=region,
                row_nr=row_nr,
                col_nr=col_nr,
                row_label=row_label,
                column_label=column_label,
                fallback_label=row_hit.get("target_label"),
                match_type="row_scan",
                matched_labels=[row_hit.get("target_label")],
            )
            if item:
                out.append(item)

    return out


def _sheet_collect_column_scan(
    region: Dict[str, Any],
    col_hits: List[Dict[str, Any]],
) -> List[Dict[str, Any]]:
    out = []
    rows_by_nr = _sheet_rows_by_nr(region)

    data_row_start = region.get("data_row_start")
    candidate_rows = []

    for row_nr, meta in rows_by_nr.items():
        kind = str(meta.get("kind") or "")
        if kind == "data_row":
            candidate_rows.append(int(row_nr))
        elif data_row_start is not None and int(row_nr) >= int(data_row_start):
            candidate_rows.append(int(row_nr))

    candidate_rows = sorted(set(candidate_rows))
    if not candidate_rows:
        candidate_rows = sorted(rows_by_nr.keys())

    for col_hit in col_hits:
        col_nr = int(col_hit["column_nr"])
        column_label = col_hit.get("label") or _sheet_column_label(region, col_nr)

        for row_nr in candidate_rows:
            row_label = _sheet_primary_row_label(region, row_nr)

            item = _sheet_make_item(
                region=region,
                row_nr=row_nr,
                col_nr=col_nr,
                row_label=row_label,
                column_label=column_label,
                fallback_label=col_hit.get("target_label"),
                match_type="column_scan",
                matched_labels=[col_hit.get("target_label")],
            )
            if item:
                out.append(item)

    return out


def _sheet_dedupe_items(items: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    out = []
    seen = set()

    for item in items or []:
        key = (
            item.get("region_id"),
            item.get("Row"),
            item.get("Column"),
            item.get("Value"),
            item.get("row_label"),
            item.get("column_label"),
            item.get("match_type"),
        )
        if key in seen:
            continue
        seen.add(key)
        out.append(item)

    out.sort(
        key=lambda x: (
            x.get("Row") if x.get("Row") is not None else 10**9,
            x.get("Column") if x.get("Column") is not None else 10**9,
            str(x.get("row_label") or ""),
            str(x.get("column_label") or ""),
        )
    )
    return out

# Single node

def safe_invoke_tool(tool_name: str, tool_args: Dict[str, Any]) -> Dict[str, Any]:

    try:
        tool = tools_by_name[tool_name]
        observation = tool.invoke(tool_args)

        if not isinstance(observation, dict):
            return {
                "tool": tool_name,
                "status": "ERROR",
                "message": f"Tool returned non-dict output: {type(observation).__name__}",
                "data": [],
                "sources": [],
            }

        return observation

    except Exception as e:
        return {
            "tool": tool_name,
            "status": "ERROR",
            "message": f"Tool execution failed: {repr(e)}",
            "data": [],
            "sources": [],
        }

def count_tool_calls(result: dict) -> int:
    return sum(
        1
        for m in result.get("messages", [])
        if isinstance(m, ToolMessage)
    )

