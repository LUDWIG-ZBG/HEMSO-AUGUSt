def _source_ref_to_dict(source: Any) -> Dict[str, Any]:
    if source is None:
        return {}

    if isinstance(source, dict):
        return {
            "doc_id": source.get("doc_id"),
            "element_id": source.get("element_id"),
            "page": source.get("page"),
            "element_type": source.get("element_type"),
        }

    return {
