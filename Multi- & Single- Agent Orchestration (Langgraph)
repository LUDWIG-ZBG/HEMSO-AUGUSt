def build_navigation_memory_update(result: ToolResultRecord) -> Dict[str, Any]:
    update = empty_navigation_memory()

    if not isinstance(result, ToolResultRecord):
        return update

    if result.status != "Ok":
        return update

    if result.tool == "similarity_search":
        query_text = str(result.tool_args.get("query_text") or "").strip()

        top_element_ids = [
            item.get("element_id")
            for item in result.data[:4]
            if item.get("element_id")
        ]

        update["searches"].append({
            "tool": "similarity_search",
            "query_text": query_text,
            "result_count": result.result_count,
            "top_element_ids": top_element_ids,
        })

        for rank, item in enumerate(result.data[:4], start=1):
            element_id = item.get("element_id")
            if not element_id:
                continue

            update["elements"][element_id] = {
                "doc_id": item.get("doc_id"),
                "element_id": element_id,
                "page": item.get("page"),
                "element_type": item.get("element_type"),
                "file_type": infer_file_type(item.get("doc_id")),
                "found_by": "similarity_search",
                "query_text": query_text,
                "rank": rank,
                "summary_hint": shorten_text(item.get("summary_text"), 250),
            }

        return update

    if result.tool == "sheet_labels":
        if not result.data:
            return update

        source = _source_ref_to_dict(result.sources[0] if result.sources else None)
        element_id = result.tool_args.get("element_id") or source.get("element_id")
        if not element_id:
            return update

        item = result.data[0]

        row_labels = _shorten_list(item.get("row_labels", []), max_items=160, max_item_len=100)
        column_labels = _shorten_list(item.get("column_labels", []), max_items=80, max_item_len=100)

        update["sheets"][element_id] = {
            "doc_id": source.get("doc_id"),
            "element_id": element_id,
            "page": source.get("page"),
            "element_type": source.get("element_type"),
            "sheet_name": item.get("sheet_name"),
            "sheet_nr": item.get("sheet_nr"),
            "row_labels": row_labels,
            "column_labels": column_labels,
        }

        update["elements"][element_id] = {
            "doc_id": source.get("doc_id"),
            "element_id": element_id,
            "page": source.get("page"),
            "element_type": source.get("element_type"),
            "file_type": infer_file_type(source.get("doc_id")),
            "found_by": "sheet_labels",
            "summary_hint": f"Sheet profile: {len(row_labels)} row labels, {len(column_labels)} column labels.",
        }

        return update

    if result.tool == "find_neighbours":
        seed_element_id = str(result.tool_args.get("element_id") or "").strip()
        eps = result.tool_args.get("eps")

        neighbour_ids = [
            item.get("element_id")
            for item in result.data
            if item.get("element_id")
        ]

        if seed_element_id:
            update["neighbours"][seed_element_id] = {
                "seed_element_id": seed_element_id,
                "eps": eps,
                "neighbour_element_ids": neighbour_ids[:30],
                "count": len(neighbour_ids),
            }

        for source in result.sources[:30]:
            s = _source_ref_to_dict(source)
            element_id = s.get("element_id")
            if not element_id:
                continue

            update["elements"][element_id] = {
                "doc_id": s.get("doc_id"),
                "element_id": element_id,
                "page": s.get("page"),
                "element_type": s.get("element_type"),
                "file_type": infer_file_type(s.get("doc_id")),
                "found_by": "find_neighbours",
                "neighbour_of": seed_element_id,
            }

        return update

    return update


