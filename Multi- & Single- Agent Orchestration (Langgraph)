def _normalize_tool_args_for_signature(tool_name: str, tool_args: Dict[str, Any]) -> Dict[str, Any]:
    if tool_name == "similarity_search":
        q = str(tool_args.get("query_text", "")).strip().lower()
        q = re.sub(r"\s+", " ", q)
        return {"query_text": q}

    if tool_name == "clause_lookup":
        ids = tool_args.get("element_id", [])
        if isinstance(ids, str):
            ids = [ids]
        ids = sorted({str(x).strip() for x in ids if str(x).strip()})
        return {"element_id": ids}

    if tool_name == "sheet_lookup":
        labels = tool_args.get("target_labels", [])
        if isinstance(labels, str):
            labels = [labels]
        labels = sorted({str(x).strip().lower() for x in labels if str(x).strip()})
        return {
            "element_id": str(tool_args.get("element_id", "")).strip(),
            "target_labels": labels,
        }

    if tool_name == "find_neighbours":
        return {
            "element_id": str(tool_args.get("element_id", "")).strip(),
            "eps": int(tool_args.get("eps", 0)),
        }

    return tool_args


def _tool_signature(tool_name: str, tool_args: Dict[str, Any]) -> str:
    normalized = _normalize_tool_args_for_signature(tool_name, tool_args)
    return f"{tool_name}::{json.dumps(normalized, ensure_ascii=False, sort_keys=True)}"

def validate_or_route_tool_call(
    tool_name: str,
    tool_args: Dict[str, Any],
    state: MultiAugustState,
) -> Tuple[str, Dict[str, Any], Optional[ToolObservation]]:
    qp = _coerce_query_plan(state)

    # clause_lookup
    if tool_name == "clause_lookup":
        element_ids = tool_args.get("element_id", [])
        if isinstance(element_ids, str):
            element_ids = [element_ids]

        meta = get_element_metadata(element_ids)

        missing_ids = [eid for eid in element_ids if eid not in meta]
        if missing_ids:
            return tool_name, tool_args, ToolObservation(
                tool=tool_name,
                status="ERROR",
                message=f"Metadata saknas för element_id: {missing_ids}",
                tool_args=tool_args,
            )

        non_pdf = [eid for eid, m in meta.items() if m["file_type"] != "pdf"]
        if non_pdf:
            return tool_name, tool_args, ToolObservation(
                tool=tool_name,
                status="ERROR",
                message=f"clause_lookup får endast användas för .pdf. Fel element_id: {non_pdf}",
                tool_args=tool_args,
            )

        return tool_name, tool_args, None

    # sheet_labels
    if tool_name == "sheet_labels":
        element_id = tool_args.get("element_id")
        meta = get_element_metadata([element_id]).get(element_id)

        if not meta:
            return tool_name, tool_args, ToolObservation(
                tool=tool_name,
                status="ERROR",
                message=f"Metadata saknas för element_id: {element_id}",
                tool_args=tool_args,
            )

        if meta["file_type"] not in {"xlsx", "xls"}:
            return tool_name, tool_args, ToolObservation(
                tool=tool_name,
                status="ERROR",
                message=f"sheet_labels får endast användas för .xlsx/.xls. element_id={element_id} tillhör {meta['file_type']}",
                tool_args=tool_args,
            )

        normalized_args = {
            "element_id": element_id,
        }
        return tool_name, normalized_args, None

    # sheet_lookup
    if tool_name == "sheet_lookup":
        element_id = tool_args.get("element_id")
        meta = get_element_metadata([element_id]).get(element_id)

        if not meta:
            return tool_name, tool_args, ToolObservation(
                tool=tool_name,
                status="ERROR",
                message=f"Metadata saknas för element_id: {element_id}",
                tool_args=tool_args,
            )

        if meta["file_type"] not in {"xlsx", "xls"}:
            return tool_name, tool_args, ToolObservation(
                tool=tool_name,
                status="ERROR",
                message=f"sheet_lookup får endast användas för .xlsx/.xls. element_id={element_id} tillhör {meta['file_type']}",
                tool_args=tool_args,
            )

        target_labels = tool_args.get("target_labels") # or qp.target_labels
        if not target_labels:
            return tool_name, tool_args, ToolObservation(
                tool=tool_name,
                status="ERROR",
                message="sheet_lookup kräver target_labels. Inga target_labels fanns i tool_args eller query_plan.",
                tool_args=tool_args,
            )

        normalized_args = {
            "element_id": element_id,
            "target_labels": target_labels,
        }
        return tool_name, normalized_args, None

    return tool_name, tool_args, None

def infer_file_type(doc_id: Optional[str]) -> str:
    return Path(str(doc_id or "")).suffix.lower().lstrip(".")

def get_element_metadata(element_ids: Union[str, List[str]]) -> Dict[str, Dict[str, Any]]:
    if isinstance(element_ids, str):
        element_ids = [element_ids]

    element_ids = [str(x).strip() for x in (element_ids or []) if str(x).strip()]
    if not element_ids:
        return {}

    query = f"""
        SELECT
            doc_id,
            element_id,
            page,
            element_type
        FROM {DBSQL_TABLE}
        WHERE element_id IN ({_placeholders(element_ids)})
    """

    rows = dbsql_fetch_all(query, element_ids)

    out = {}
    for row in rows:
        doc_id = row["doc_id"]
        out[row["element_id"]] = {
            "doc_id": doc_id,
            "page": row["page"],
            "element_type": row["element_type"],
            "file_type": infer_file_type(doc_id),
        }

    return out

# Finalizer helpers
def extract_final_text(response_or_content: Any) -> str:
    """
    Returnerar endast den användarsynliga sluttexten från ett modell-svar.

    Hanterar:
    - AIMessage med .content
    - vanlig sträng
    - lista av content-blocks
    - JSON-sträng som innehåller content-blocks
    """

    content = getattr(response_or_content, "content", response_or_content)

    def _from_obj(obj: Any) -> list[str]:
        parts = []

        if obj is None:
            return parts

        if isinstance(obj, str):
            s = obj.strip()
            if not s:
                return parts

            # Försök tolka JSON-sträng som content-blocks
            if (s.startswith("[") and s.endswith("]")) or (s.startswith("{") and s.endswith("}")):
                try:
                    parsed = json.loads(s)
                    return _from_obj(parsed)
                except Exception:
                    return [s]

            return [s]

        if isinstance(obj, list):
            for item in obj:
                parts.extend(_from_obj(item))
            return parts

        if isinstance(obj, dict):
            block_type = obj.get("type")

            # Det här är den vanliga sluttexten vi vill åt
            if block_type == "text":
                text_value = obj.get("text", "")
                if isinstance(text_value, str) and text_value.strip():
                    parts.append(text_value.strip())
                else:
                    parts.extend(_from_obj(text_value))
                return parts

            # Resonemang ska inte med i slutanvändarsvaret
            if block_type in {"reasoning", "summary", "tool_use", "input_json"}:
                return parts

            # Vissa format kan ha nested content
            if "content" in obj:
                parts.extend(_from_obj(obj["content"]))
                return parts

            # Fallback: plocka textfält om de finns
            for key in ("text", "output_text", "value"):
                if key in obj and isinstance(obj[key], str) and obj[key].strip():
                    parts.append(obj[key].strip())
                    return parts

            return parts

        # Okända objekt
        text_attr = getattr(obj, "text", None)
        type_attr = getattr(obj, "type", None)

        if type_attr == "text" and isinstance(text_attr, str) and text_attr.strip():
            return [text_attr.strip()]

        return parts

    text_parts = _from_obj(content)
    final_text = "\n".join(p for p in text_parts if p).strip()

    return final_text

def group_evidence_by_page(evidence_items: List[EvidenceItem]) -> List[Dict[str, Any]]:
    grouped = defaultdict(lambda: {
        "doc_id": None,
        "page": None,
        "evidence_ids": [],
    })

    for e in evidence_items:
        if isinstance(e, dict):
            e = EvidenceItem(**e)

        key = (e.source.doc_id, e.source.page)
        bucket = grouped[key]

        bucket["doc_id"] = e.source.doc_id
        bucket["page"] = e.source.page

        if e.evidence_id and e.evidence_id not in bucket["evidence_ids"]:
            bucket["evidence_ids"].append(e.evidence_id)

    out = list(grouped.values())
    out.sort(key=lambda x: (x["doc_id"] or "", x["page"] if x["page"] is not None else 10**9))
    return out

def dedupe_sources(sources: List[SourceRef]) -> List[SourceRef]:
    out = []
    seen = set()

    for s in sources:
        if isinstance(s, dict):
            s = SourceRef(**s)

        key = (s.doc_id, s.element_id, s.page)
        if key not in seen:
            seen.add(key)
            out.append(s)

    return out

