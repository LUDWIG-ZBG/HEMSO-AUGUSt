# Normalizera lista
def _normalize_list(value: Any) -> List[str]:
    if value is None:
        return []

    if isinstance(value, str):
        value = [value]

    if not isinstance(value, list):
        return []

    out = []
    seen = set()

    for item in value:
        s = str(item).strip()
        if not s:
            continue
        if s not in seen:
            seen.add(s)
            out.append(s)

    return out

# Task handler
def compact_evidence_for_llm(e: EvidenceItem, max_len: int = 700) -> str:
    """
    Compact representation of evidence for the task handler.
    Keeps enough context for routing decisions without sending full raw clauses/tables.
    """
    if isinstance(e, dict):
        e = EvidenceItem(**e)

    doc_name = Path(str(e.source.doc_id or "")).name

    return (
        f"[{e.evidence_id}] "
        f"{doc_name} | "
        f"element={e.source.element_id} | "
        f"page={e.source.page} | "
        f"type={e.source.element_type} | "
        f"tool={e.tool}\n"
        f"{shorten_text(e.context, max_len)}"
    )

def _shorten_list(values, max_items=80, max_item_len=80):
    out = []
    for v in values or []:
        s = str(v).strip()
        if not s:
            continue
        if len(s) > max_item_len:
            s = s[:max_item_len].rstrip() + "..."
        out.append(s)
        if len(out) >= max_items:
            break
    return out

def compact_tool_result_for_llm(r: ToolResultRecord, max_items: int = 5) -> Dict[str, Any]:
    if r.tool == "sheet_labels":
        return {
            "tool": r.tool,
            "status": r.status,
            "message": shorten_text(r.message, 500),
            "result_kind": r.result_kind,
            "evidence_candidate": r.evidence_candidate,
            "result_count": r.result_count,
            "tool_args": r.tool_args,
            "sources": [
                {
                    "doc_id": s.doc_id,
                    "element_id": s.element_id,
                    "page": s.page,
                    "element_type": s.element_type,
                }
                for s in r.sources[:max_items]
            ],
            "data_preview": [
                {
                    "sheet_name": item.get("sheet_name"),
                    "sheet_nr": item.get("sheet_nr"),
                    "row_labels": _shorten_list(item.get("row_labels"), max_items=120),
                    "column_labels": _shorten_list(item.get("column_labels"), max_items=80),
                    "target_labels": shorten_text(item.get("target_labels"), 3000),
                }
                for item in r.data[:1]
            ],
        }

    return {
        "tool": r.tool,
        "status": r.status,
        "message": shorten_text(r.message, 300),
        "result_kind": r.result_kind,
        "evidence_candidate": r.evidence_candidate,
        "result_count": r.result_count,
        "tool_args": r.tool_args,
        "sources": [
            {
                "doc_id": s.doc_id,
                "element_id": s.element_id,
                "page": s.page,
                "element_type": s.element_type,
            }
            for s in r.sources[:max_items]
        ],
        "data_preview": [
            {
                k: shorten_text(v, 200)
                for k, v in item.items()
                if k in {
                    "doc_id", "element_id", "page", "element_type",
                    "summary_text", "row_label", "column_label", "Value",
                    "Value_num", "Row", "Column", "Column_letter",
                    "match_type", "matched_labels",
                }
            }
            for item in r.data[:max_items]
        ],
    }


